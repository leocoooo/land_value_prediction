    "    \"            'MAE Test': [0, results_df.loc[2, 'MAE']]\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"        print(\\\"\\\\n📊 Comparaison des modèles :\\\\n\\\")\\n\",\n",
    "    \"        print(comparison.to_string(index=False))\\n\",\n",
    "    \"    except:\\n\",\n",
    "    \"        print(\\\"\\\\n⚠️  Résultats MCO non disponibles pour comparaison\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"\\\\n⚠️  Modèle MCO non entraîné. Comparaison impossible.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\"\\\"\\n\",\n",
    "    \"💡 Différences clés SVR vs MCO :\\n\",\n",
    "    \"\\n\",\n",
    "    \"   🔹 MCO (Linear Regression) :\\n\",\n",
    "    \"      • Hypothèse de linéarité stricte\\n\",\n",
    "    \"      • Très rapide à entraîner\\n\",\n",
    "    \"      • Interprétable (coefficients)\\n\",\n",
    "    \"      • Sensible aux outliers\\n\",\n",
    "    \"\\n\",\n",
    "    \"   🔹 SVR (RBF) :\\n\",\n",
    "    \"      • Capture les non-linéarités\\n\",\n",
