    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## XGboost Optuna\",\n",
    "   \"id\": \"47a18d42d7b0d582\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"ÉTAPE 4.5 : OPTIMISATION HYPERPARAMÈTRES XGBOOST AVEC OPTUNA\\n\",\n",
    "    \"============================================================\\n\",\n",
    "    \"Objectif : Trouver les meilleurs hyperparamètres pour XGBoost\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\\n\",\n",
    "    \"import xgboost as xgb\\n\",\n",
    "    \"import optuna\\n\",\n",
    "    \"from optuna.visualization import plot_optimization_history, plot_param_importances\\n\",\n",
    "    \"from time import time\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"OPTIMISATION XGBOOST AVEC OPTUNA\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. DÉFINITION DE LA FONCTION OBJECTIF\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n1️⃣  Configuration de l'optimisation Optuna...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def objective(trial):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Fonction objectif pour Optuna\\n\",\n",
    "    \"    On cherche à MINIMISER le RMSE sur le set de validation\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Définir l'espace de recherche des hyperparamètres\\n\",\n",
    "    \"    params = {\\n\",\n",
    "    \"        # Paramètres de structure des arbres\\n\",\n",
    "    \"        'max_depth': trial.suggest_int('max_depth', 4, 15),\\n\",\n",
    "    \"        'min_child_weight': trial.suggest_int('min_child_weight', 1, 10),\\n\",\n",
    "    \"        'gamma': trial.suggest_float('gamma', 0, 5),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Paramètres de boosting\\n\",\n",
    "    \"        'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.3, log=True),\\n\",\n",
    "    \"        'n_estimators': trial.suggest_int('n_estimators', 100, 1000, step=50),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Paramètres de subsampling\\n\",\n",
    "    \"        'subsample': trial.suggest_float('subsample', 0.6, 1.0),\\n\",\n",
    "    \"        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.6, 1.0),\\n\",\n",
    "    \"        'colsample_bylevel': trial.suggest_float('colsample_bylevel', 0.6, 1.0),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Régularisation\\n\",\n",
    "    \"        'reg_alpha': trial.suggest_float('reg_alpha', 0, 10),  # L1\\n\",\n",
    "    \"        'reg_lambda': trial.suggest_float('reg_lambda', 0, 10),  # L2\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Autres paramètres\\n\",\n",
    "    \"        'random_state': 42,\\n\",\n",
    "    \"        'n_jobs': -1,\\n\",\n",
    "    \"        'tree_method': 'hist',\\n\",\n",
    "    \"        'verbosity': 0\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Entraîner le modèle\\n\",\n",
    "    \"    model = xgb.XGBRegressor(**params)\\n\",\n",
    "    \"    model.fit(\\n\",\n",
    "    \"        X_train_final, y_train,\\n\",\n",
    "    \"        eval_set=[(X_val_final, y_val)],\\n\",\n",
    "    \"        early_stopping_rounds=50,\\n\",\n",
    "    \"        verbose=False\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Prédire sur validation\\n\",\n",
    "    \"    y_val_pred = model.predict(X_val_final)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculer RMSE (métrique à minimiser)\\n\",\n",
    "    \"    rmse = np.sqrt(mean_squared_error(y_val, y_val_pred))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return rmse\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"   ✓ Fonction objectif définie\\\")\\n\",\n",
    "    \"print(\\\"   • Métrique optimisée : RMSE sur validation\\\")\\n\",\n",
    "    \"print(\\\"   • Stratégie : Bayesian Optimization avec Tree-structured Parzen Estimator\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 2. LANCEMENT DE L'OPTIMISATION\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"2️⃣  LANCEMENT DE L'OPTIMISATION\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Optimisation en cours... (cela peut prendre 5-15 minutes)\\\")\\n\",\n",
    "    \"print(\\\"   Vous pouvez réduire n_trials si c'est trop long\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer l'étude Optuna\\n\",\n",
    "    \"study = optuna.create_study(\\n\",\n",
    "    \"    direction='minimize',  # On veut minimiser le RMSE\\n\",\n",
    "    \"    sampler=optuna.samplers.TPESampler(seed=42),\\n\",\n",
    "    \"    pruner=optuna.pruners.MedianPruner(n_warmup_steps=10)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Lancer l'optimisation\\n\",\n",
    "    \"start_time = time()\\n\",\n",
    "    \"study.optimize(\\n\",\n",
    "    \"    objective,\\n\",\n",
    "    \"    n_trials=50,  # Nombre d'essais (augmenter à 100-200 pour meilleur résultat)\\n\",\n",
    "    \"    timeout=None,\\n\",\n",
    "    \"    show_progress_bar=True,\\n\",\n",
    "    \"    n_jobs=1  # Parallélisation au niveau d'Optuna\\n\",\n",
    "    \")\\n\",\n",
    "    \"optim_time = time() - start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n   ✓ Optimisation terminée en {optim_time/60:.2f} minutes\\\")\\n\",\n",
    "    \"print(f\\\"   • Nombre de trials complétés : {len(study.trials)}\\\")\\n\",\n",
    "    \"print(f\\\"   • Meilleur RMSE : {study.best_value:.2f} €/m²\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 3. MEILLEURS HYPERPARAMÈTRES\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"3️⃣  MEILLEURS HYPERPARAMÈTRES TROUVÉS\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"best_params = study.best_params\\n\",\n",
    "    \"print(\\\"\\\\n📋 Hyperparamètres optimaux :\\\\n\\\")\\n\",\n",
    "    \"for param, value in best_params.items():\\n\",\n",
    "    \"    print(f\\\"   • {param:20s} : {value}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 4. ENTRAÎNEMENT DU MODÈLE OPTIMISÉ\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"4️⃣  ENTRAÎNEMENT DU MODÈLE OPTIMISÉ\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nEntraînement avec les meilleurs hyperparamètres...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer le modèle avec les meilleurs paramètres\\n\",\n",
    "    \"best_xgb = xgb.XGBRegressor(\\n\",\n",
    "    \"    **best_params,\\n\",\n",
    "    \"    random_state=42,\\n\",\n",
    "    \"    n_jobs=-1,\\n\",\n",
    "    \"    tree_method='hist'\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Entraîner\\n\",\n",
    "    \"best_xgb.fit(\\n\",\n",
    "    \"    X_train_final, y_train,\\n\",\n",
    "    \"    eval_set=[(X_val_final, y_val)],\\n\",\n",
    "    \"    early_stopping_rounds=50,\\n\",\n",
    "    \"    verbose=False\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"   ✓ Modèle optimisé entraîné\\\")\\n\",\n",
    "    \"print(f\\\"   • Meilleure itération : {best_xgb.best_iteration}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 5. ÉVALUATION COMPLÈTE\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"5️⃣  ÉVALUATION DU MODÈLE OPTIMISÉ\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prédictions\\n\",\n",
    "    \"y_train_pred_opt = best_xgb.predict(X_train_final)\\n\",\n",
    "    \"y_val_pred_opt = best_xgb.predict(X_val_final)\\n\",\n",
    "    \"y_test_pred_opt = best_xgb.predict(X_test_final)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calcul des métriques\\n\",\n",
    "    \"def compute_all_metrics(y_true, y_pred, dataset_name):\\n\",\n",
    "    \"    \\\"\\\"\\\"Calcule toutes les métriques de régression\\\"\\\"\\\"\\n\",\n",
    "    \"    mse = mean_squared_error(y_true, y_pred)\\n\",\n",
    "    \"    rmse = np.sqrt(mse)\\n\",\n",
    "    \"    mae = mean_absolute_error(y_true, y_pred)\\n\",\n",
    "    \"    r2 = r2_score(y_true, y_pred)\\n\",\n",
    "    \"    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Médiane de l'erreur absolue\\n\",\n",
    "    \"    median_ae = np.median(np.abs(y_true - y_pred))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Erreur maximale\\n\",\n",
    "    \"    max_error = np.max(np.abs(y_true - y_pred))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'Dataset': dataset_name,\\n\",\n",
    "    \"        'R²': r2,\\n\",\n",
    "    \"        'RMSE': rmse,\\n\",\n",
    "    \"        'MAE': mae,\\n\",\n",
    "    \"        'MAPE (%)': mape,\\n\",\n",
    "    \"        'Median AE': median_ae,\\n\",\n",
    "    \"        'Max Error': max_error\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_optimized = []\\n\",\n",
    "    \"results_optimized.append(compute_all_metrics(y_train, y_train_pred_opt, 'Train'))\\n\",\n",
    "    \"results_optimized.append(compute_all_metrics(y_val, y_val_pred_opt, 'Validation'))\\n\",\n",
    "    \"results_optimized.append(compute_all_metrics(y_test, y_test_pred_opt, 'Test'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_opt_df = pd.DataFrame(results_optimized)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Performances du modèle OPTIMISÉ :\\\\n\\\")\\n\",\n",
    "    \"print(results_opt_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 6. COMPARAISON AVANT/APRÈS OPTIMISATION\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"6️⃣  COMPARAISON AVANT/APRÈS OPTIMISATION\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Résultats du modèle de base (de l'étape 4)\\n\",\n",
    "    \"baseline_xgb = {\\n\",\n",
    "    \"    'Modèle': 'XGBoost Baseline',\\n\",\n",
    "    \"    'R² Test': 0.7331,\\n\",\n",
    "    \"    'RMSE Test': 1852.22\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"optimized_xgb = {\\n\",\n",
    "    \"    'Modèle': 'XGBoost Optimisé',\\n\",\n",
    "    \"    'R² Test': results_optimized[2]['R²'],\\n\",\n",
    "    \"    'RMSE Test': results_optimized[2]['RMSE']\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"comparison = pd.DataFrame([baseline_xgb, optimized_xgb])\\n\",\n",
    "    \"print(\\\"\\\\n📊 Comparaison des performances :\\\\n\\\")\\n\",\n",
    "    \"print(comparison.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calcul du gain\\n\",\n",
    "    \"r2_gain = (optimized_xgb['R² Test'] - baseline_xgb['R² Test']) / baseline_xgb['R² Test'] * 100\\n\",\n",
    "    \"rmse_gain = (baseline_xgb['RMSE Test'] - optimized_xgb['RMSE Test']) / baseline_xgb['RMSE Test'] * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n📈 Gains de l'optimisation :\\\")\\n\",\n",
    "    \"print(f\\\"   • R² : {r2_gain:+.2f}%\\\")\\n\",\n",
    "    \"print(f\\\"   • RMSE : {rmse_gain:+.2f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"if rmse_gain > 0:\\n\",\n",
    "    \"    print(f\\\"   ✓ Le modèle optimisé est MEILLEUR de {rmse_gain:.2f}%\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"   ⚠️  Le modèle baseline était déjà très bon (gain marginal)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 7. MÉTRIQUES COMPLÉMENTAIRES (Courbe de calibration)\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"7️⃣  MÉTRIQUES COMPLÉMENTAIRES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Pour la régression, on ne peut pas calculer l'AUC directement\\n\",\n",
    "    \"# Mais on peut créer des métriques similaires :\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1. Coefficient de corrélation de Spearman (rang)\\n\",\n",
    "    \"from scipy.stats import spearmanr, pearsonr\\n\",\n",
    "    \"\\n\",\n",
    "    \"spearman_corr, _ = spearmanr(y_test, y_test_pred_opt)\\n\",\n",
    "    \"pearson_corr, _ = pearsonr(y_test, y_test_pred_opt)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Corrélations prédictions vs valeurs réelles :\\\")\\n\",\n",
    "    \"print(f\\\"   • Corrélation de Pearson  : {pearson_corr:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"   • Corrélation de Spearman : {spearman_corr:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2. Proportion de prédictions dans un intervalle acceptable\\n\",\n",
    "    \"tolerance_10pct = np.mean(np.abs((y_test - y_test_pred_opt) / y_test) <= 0.10) * 100\\n\",\n",
    "    \"tolerance_20pct = np.mean(np.abs((y_test - y_test_pred_opt) / y_test) <= 0.20) * 100\\n\",\n",
    "    \"tolerance_30pct = np.mean(np.abs((y_test - y_test_pred_opt) / y_test) <= 0.30) * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Précision des prédictions :\\\")\\n\",\n",
    "    \"print(f\\\"   • Prédictions à ±10% : {tolerance_10pct:.2f}%\\\")\\n\",\n",
    "    \"print(f\\\"   • Prédictions à ±20% : {tolerance_20pct:.2f}%\\\")\\n\",\n",
    "    \"print(f\\\"   • Prédictions à ±30% : {tolerance_30pct:.2f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 3. Si vous voulez vraiment une métrique type AUC :\\n\",\n",
    "    \"# Transformons en problème de classification binaire (prix > médiane)\\n\",\n",
    "    \"y_test_binary = (y_test > y_test.median()).astype(int)\\n\",\n",
    "    \"y_test_pred_binary = (y_test_pred_opt > y_test.median()).astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"from sklearn.metrics import roc_auc_score, accuracy_score\\n\",\n",
    "    \"auc_score = roc_auc_score(y_test_binary, y_test_pred_opt)\\n\",\n",
    "    \"accuracy = accuracy_score(y_test_binary, y_test_pred_binary)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Métriques de classification (prix > médiane) :\\\")\\n\",\n",
    "    \"print(f\\\"   • AUC-ROC : {auc_score:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"   • Accuracy : {accuracy:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n💡 Note : L'AUC en régression n'est pas standard.\\\")\\n\",\n",
    "    \"print(\\\"   Les corrélations et intervalles de tolérance sont plus pertinents.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 8. VISUALISATIONS\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"8️⃣  VISUALISATIONS\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig = plt.figure(figsize=(18, 10))\\n\",\n",
    "    \"gs = fig.add_gridspec(2, 3, hspace=0.3, wspace=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Plot 1 : Historique d'optimisation ---\\n\",\n",
    "    \"ax1 = fig.add_subplot(gs[0, 0])\\n\",\n",
    "    \"trials_df = study.trials_dataframe()\\n\",\n",
    "    \"ax1.plot(trials_df['number'], trials_df['value'], 'o-', alpha=0.6)\\n\",\n",
    "    \"ax1.axhline(y=study.best_value, color='r', linestyle='--',\\n\",\n",
    "    \"           label=f'Meilleur: {study.best_value:.2f}')\\n\",\n",
    "    \"ax1.set_xlabel('Numéro du trial')\\n\",\n",
    "    \"ax1.set_ylabel('RMSE (€/m²)')\\n\",\n",
    "    \"ax1.set_title('Historique d\\\\'optimisation Optuna')\\n\",\n",
