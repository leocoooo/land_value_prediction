    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"3️⃣  COMPARAISON DES 3 MODÈLES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Récupérer les résultats MCO (de l'étape 3)\\n\",\n",
    "    \"mco_test = {\\n\",\n",
    "    \"    'Modèle': 'MCO',\\n\",\n",
    "    \"    'Dataset': 'Test',\\n\",\n",
    "    \"    'R²': 0.6400,\\n\",\n",
