    "\n",
    "📊 TOP 5 FEATURES :\n",
    "\"\"\")\n",
    "\n",
    "for idx, row in shap_importance.head(5).iterrows():\n",
    "    feature = row['Feature']\n",
    "    impact = row['Mean_|SHAP|']\n",
    "    pct_pos = (shap_df[feature] > 0).sum() / len(shap_df) * 100\n",
    "    print(f\"   {idx+1}. {feature:30s} : {impact:7.2f} €/m² ({pct_pos:.1f}% positive)\")\n",
    "\n",
    "# Analyser la cohérence avec l'importance XGBoost\n",
    "xgb_importance = pd.DataFrame({\n",
    "    'Feature': X_test_sample.columns,\n",
