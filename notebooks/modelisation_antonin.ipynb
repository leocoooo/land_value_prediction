   "source": "## Shapleyyy",
   "id": "2f2799d0677d35a8"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "\"\"\"\n",
    "ÉTAPE 6 : ANALYSE SHAP - INTERPRÉTABILITÉ AVANCÉE\n",
    "==================================================\n",
    "Objectif : Comprendre comment le modèle XGBoost prend ses décisions\n",
    "\"\"\"\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import shap\n",
    "from time import time\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"ÉTAPE 6 : ANALYSE SHAP (SHapley Additive exPlanations)\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\"\"\n",
    "💡 SHAP explique les prédictions en calculant la contribution de chaque feature\n",
    "   Basé sur la théorie des jeux coopératifs (valeurs de Shapley)\n",
    "\"\"\")\n",
    "\n",
    "# ============================================================================\n",
    "# 1. INITIALISATION DE L'EXPLAINER SHAP\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"1️⃣  INITIALISATION DE L'EXPLAINER SHAP\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n⏳ Création de l'explainer (peut prendre 1-2 minutes)...\")\n",
    "start_time = time()\n",
    "\n",
    "# Pour XGBoost, on utilise TreeExplainer (très rapide et exact)\n",
    "explainer = shap.TreeExplainer(best_xgb)\n",
    "\n",
    "print(f\"   ✓ Explainer créé en {time() - start_time:.2f} secondes\")\n",
    "\n",
    "# ============================================================================\n",
    "# 2. CALCUL DES VALEURS SHAP\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"2️⃣  CALCUL DES VALEURS SHAP\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# On calcule sur un échantillon du test pour des raisons de performance\n",
    "# Pour l'analyse complète, utilisez tout le test set\n",
    "sample_size = 2000  # Augmenter à 10000 ou len(X_test_final) pour analyse complète\n",
    "print(f\"\\n📊 Calcul des valeurs SHAP sur {sample_size} échantillons du test set...\")\n",
    "\n",
    "# Échantillonnage stratifié par quartile de prix\n",
    "y_test_quartiles = pd.qcut(y_test, q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])\n",
    "sample_indices = []\n",
    "for quartile in ['Q1', 'Q2', 'Q3', 'Q4']:\n",
    "    quartile_indices = y_test[y_test_quartiles == quartile].index\n",
    "    n_samples = min(sample_size // 4, len(quartile_indices))\n",
    "    sample_indices.extend(np.random.choice(quartile_indices, n_samples, replace=False))\n",
    "\n",
    "X_test_sample = X_test_final.loc[sample_indices]\n",
    "y_test_sample = y_test.loc[sample_indices]\n",
    "\n",
    "print(\"   ⏳ Calcul en cours...\")\n",
    "start_time = time()\n",
    "shap_values = explainer.shap_values(X_test_sample)\n",
    "calc_time = time() - start_time\n",
    "\n",
    "print(f\"   ✓ Valeurs SHAP calculées en {calc_time:.2f} secondes\")\n",
    "print(f\"   • Shape des valeurs SHAP : {shap_values.shape}\")\n",
    "print(f\"   • Valeur de base (expected value) : {explainer.expected_value:.2f} €/m²\")\n",
    "\n",
    "# ============================================================================\n",
    "# 3. GLOBAL FEATURE IMPORTANCE\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"3️⃣  IMPORTANCE GLOBALE DES FEATURES\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Calculer l'importance moyenne absolue\n",
    "shap_importance = pd.DataFrame({\n",
    "    'Feature': X_test_sample.columns,\n",
    "    'Mean_|SHAP|': np.abs(shap_values).mean(axis=0)\n",
    "}).sort_values('Mean_|SHAP|', ascending=False)\n",
    "\n",
    "print(\"\\n📊 Top 20 features par importance SHAP :\\n\")\n",
    "print(shap_importance.head(20).to_string(index=False))\n",
    "\n",
    "# ============================================================================\n",
    "# 4. VISUALISATIONS SHAP\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"4️⃣  VISUALISATIONS SHAP\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n📊 Génération des visualisations...\")\n",
    "\n",
    "# --- Figure 1 : Summary Plot (le plus important) ---\n",
    "print(\"\\n   1/7 - Summary Plot (vue d'ensemble)...\")\n",
    "fig1, ax1 = plt.subplots(figsize=(12, 10))\n",
    "shap.summary_plot(\n",
    "    shap_values,\n",
    "    X_test_sample,\n",
    "    max_display=20,\n",
    "    show=False,\n",
    "    plot_size=(12, 10)\n",
    ")\n",
    "plt.title('SHAP Summary Plot - Impact des Features', fontsize=14, fontweight='bold', pad=20)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Figure 2 : Bar Plot (importance agrégée) ---\n",
    "print(\"   2/7 - Bar Plot (importance moyenne)...\")\n",
    "fig2, ax2 = plt.subplots(figsize=(10, 8))\n",
    "shap.summary_plot(\n",
    "    shap_values,\n",
    "    X_test_sample,\n",
    "    plot_type='bar',\n",
    "    max_display=20,\n",
    "    show=False\n",
    ")\n",
    "plt.title('SHAP Bar Plot - Importance Moyenne des Features', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Figure 3 : Dependence Plots (Top 4 features) ---\n",
    "print(\"   3/7 - Dependence Plots (top 4 features)...\")\n",
    "fig3, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "top_features = shap_importance.head(4)['Feature'].values\n",
    "\n",
    "for idx, feature in enumerate(top_features):\n",
    "    ax = axes[idx // 2, idx % 2]\n",
    "    shap.dependence_plot(\n",
    "        feature,\n",
    "        shap_values,\n",
    "        X_test_sample,\n",
    "        ax=ax,\n",
    "        show=False\n",
    "    )\n",
    "    ax.set_title(f'Dependence Plot - {feature}', fontsize=12, fontweight='bold')\n",
    "\n",
    "plt.suptitle('SHAP Dependence Plots - Top 4 Features', fontsize=14, fontweight='bold', y=0.995)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Figure 4 : Force Plot (exemple individuel) ---\n",
    "print(\"   4/7 - Force Plots (prédictions individuelles)...\")\n",
    "\n",
    "# Sélectionner 3 exemples : sous-estimé, bien prédit, surestimé\n",
    "residuals = y_test_sample - best_xgb.predict(X_test_sample)\n",
    "idx_underpredict = residuals.idxmax()  # Le plus sous-estimé\n",
    "idx_overpredict = residuals.idxmin()   # Le plus surestimé\n",
    "idx_good = residuals.abs().idxmin()    # Le mieux prédit\n",
    "\n",
    "examples = {\n",
    "    'Sous-estimé': idx_underpredict,\n",
    "    'Bien prédit': idx_good,\n",
    "    'Sur-estimé': idx_overpredict\n",
    "}\n",
    "\n",
    "fig4, axes = plt.subplots(3, 1, figsize=(16, 12))\n",
    "\n",
    "for idx, (label, example_idx) in enumerate(examples.items()):\n",
    "    sample_idx = X_test_sample.index.get_loc(example_idx)\n",
    "\n",
    "    real_price = y_test_sample.loc[example_idx]\n",
    "    pred_price = best_xgb.predict(X_test_sample.loc[[example_idx]])[0]\n",
    "\n",
    "    ax = axes[idx]\n",
    "\n",
    "    # Créer le force plot\n",
    "    shap.force_plot(\n",
    "        explainer.expected_value,\n",
    "        shap_values[sample_idx],\n",
    "        X_test_sample.iloc[sample_idx],\n",
    "        matplotlib=True,\n",
    "        show=False,\n",
    "        figsize=(16, 3)\n",
    "    )\n",
    "\n",
    "    plt.sca(ax)\n",
    "    plt.title(f'{label} - Réel: {real_price:.0f} €/m² | Prédit: {pred_price:.0f} €/m² | Erreur: {pred_price-real_price:+.0f} €/m²',\n",
    "             fontsize=11, fontweight='bold')\n",
    "\n",
    "plt.suptitle('SHAP Force Plots - Exemples de Prédictions', fontsize=14, fontweight='bold', y=0.995)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Figure 5 : Waterfall Plot (meilleur exemple) ---\n",
    "print(\"   5/7 - Waterfall Plot (meilleur prédiction)...\")\n",
    "sample_idx_good = X_test_sample.index.get_loc(idx_good)\n",
    "\n",
    "fig5, ax5 = plt.subplots(figsize=(10, 8))\n",
    "shap.waterfall_plot(\n",
    "    shap.Explanation(\n",
    "        values=shap_values[sample_idx_good],\n",
    "        base_values=explainer.expected_value,\n",
    "        data=X_test_sample.iloc[sample_idx_good],\n",
    "        feature_names=X_test_sample.columns.tolist()\n",
    "    ),\n",
    "    max_display=15,\n",
    "    show=False\n",
    ")\n",
    "real = y_test_sample.iloc[sample_idx_good]\n",
    "pred = best_xgb.predict(X_test_sample.iloc[[sample_idx_good]])[0]\n",
    "plt.title(f'Waterfall Plot - Bien Prédit\\nRéel: {real:.0f} €/m² | Prédit: {pred:.0f} €/m²',\n",
    "         fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Figure 6 : Decision Plot ---\n",
    "print(\"   6/7 - Decision Plot (trajectoires de décision)...\")\n",
    "fig6, ax6 = plt.subplots(figsize=(10, 8))\n",
    "\n",
    "# Sélectionner quelques exemples variés\n",
    "decision_indices = np.random.choice(len(X_test_sample), size=50, replace=False)\n",
    "\n",
    "shap.decision_plot(\n",
    "    explainer.expected_value,\n",
    "    shap_values[decision_indices],\n",
    "    X_test_sample.iloc[decision_indices],\n",
    "    show=False\n",
    ")\n",
    "plt.title('SHAP Decision Plot - Trajectoires de 50 Prédictions', fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Figure 7 : Analyse par quartile de prix ---\n",
    "print(\"   7/7 - Analyse SHAP par quartile de prix...\")\n",
    "fig7, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "\n",
    "for idx, quartile in enumerate(['Q1', 'Q2', 'Q3', 'Q4']):\n",
    "    ax = axes[idx // 2, idx % 2]\n",
    "\n",
    "    # Filtrer par quartile\n",
    "    quartile_mask = y_test_quartiles.loc[sample_indices] == quartile\n",
    "    X_quartile = X_test_sample[quartile_mask]\n",
    "    shap_quartile = shap_values[quartile_mask]\n",
    "\n",
    "    # Calculer importance pour ce quartile\n",
    "    importance_quartile = pd.DataFrame({\n",
    "        'Feature': X_quartile.columns,\n",
    "        'Mean_|SHAP|': np.abs(shap_quartile).mean(axis=0)\n",
    "    }).sort_values('Mean_|SHAP|', ascending=False).head(10)\n",
    "\n",
    "    ax.barh(range(len(importance_quartile)), importance_quartile['Mean_|SHAP|'].values,\n",
    "           color='steelblue', alpha=0.7)\n",
    "    ax.set_yticks(range(len(importance_quartile)))\n",
    "    ax.set_yticklabels(importance_quartile['Feature'], fontsize=9)\n",
    "    ax.set_xlabel('Mean |SHAP value|', fontsize=10)\n",
    "    ax.set_title(f'Quartile {quartile} - Prix moyen: {y_test_sample[quartile_mask].mean():.0f} €/m²',\n",
    "                fontsize=11, fontweight='bold')\n",
    "    ax.grid(alpha=0.3, axis='x')\n",
    "    ax.invert_yaxis()\n",
    "\n",
    "plt.suptitle('Importance SHAP par Quartile de Prix', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"   ✓ Toutes les visualisations générées\")\n",
