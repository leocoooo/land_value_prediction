    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"ÉTAPE 4 : MODÈLE SVR (SUPPORT VECTOR REGRESSION)\\n\",\n",
    "    \"=================================================\\n\",\n",
    "    \"Objectif : Modèle non-linéaire robuste pour la prédiction du prix au m²\\n\",\n",
    "    \"SVR est particulièrement adapté pour :\\n\",\n",
    "    \"- Relations non-linéaires complexes (via kernels)\\n\",\n",
    "    \"- Robustesse aux outliers (grâce à epsilon-insensitive loss)\\n\",\n",
    "    \"- Données de haute dimension\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
