    "    \"    'MAPE (%)': 30.36\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer tableau comparatif\\n\",\n",
    "    \"comparison_df = pd.DataFrame([\\n\",\n",
    "    \"    mco_test,\\n\",\n",
    "    \"    rf_results[2],   # Test\\n\",\n",
    "    \"    xgb_results[2]   # Test\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Comparaison sur le set de TEST :\\\\n\\\")\\n\",\n",
    "    \"print(comparison_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
