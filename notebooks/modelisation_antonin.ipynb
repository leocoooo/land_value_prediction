    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-11-18T14:07:05.468750Z\",\n",
    "     \"start_time\": \"2025-11-18T14:07:02.161005Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"ÉTAPE 1 : PRÉPARATION DES DONNÉES ET DÉCOUPAGE TRAIN/TEST\\n\",\n",
    "    \"=========================================================\\n\",\n",
    "    \"Objectif : Prédire le prix_m2 des biens immobiliers en Île-de-France\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"ANALYSE PRÉLIMINAIRE\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1. Vue d'ensemble des données\\n\",\n",
    "    \"print(f\\\"\\\\nNombre total d'observations : {len(df):,}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nStatistiques de la variable cible (prix_m2):\\\")\\n\",\n",
    "    \"print(df['prix_m2'].describe())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2. Détection des valeurs aberrantes sur la cible\\n\",\n",
    "    \"Q1 = df['prix_m2'].quantile(0.25)\\n\",\n",
    "    \"Q3 = df['prix_m2'].quantile(0.75)\\n\",\n",
    "    \"IQR = Q3 - Q1\\n\",\n",
    "    \"lower_bound = Q1 - 3 * IQR\\n\",\n",
    "    \"upper_bound = Q3 + 3 * IQR\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nBornes pour valeurs aberrantes (méthode IQR × 3):\\\")\\n\",\n",
    "    \"print(f\\\"  - Borne inférieure : {lower_bound:.2f} €/m²\\\")\\n\",\n",
    "    \"print(f\\\"  - Borne supérieure : {upper_bound:.2f} €/m²\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"outliers = df[(df['prix_m2'] < lower_bound) | (df['prix_m2'] > upper_bound)]\\n\",\n",
    "    \"print(f\\\"  - Nombre de valeurs aberrantes : {len(outliers):,} ({len(outliers)/len(df)*100:.2f}%)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 3. Gestion des valeurs manquantes\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"VALEURS MANQUANTES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"missing = df.isnull().sum()\\n\",\n",
    "    \"missing_pct = (missing / len(df)) * 100\\n\",\n",
    "    \"missing_df = pd.DataFrame({\\n\",\n",
    "    \"    'Colonne': missing.index,\\n\",\n",
    "    \"    'Manquants': missing.values,\\n\",\n",
    "    \"    'Pourcentage': missing_pct.values\\n\",\n",
    "    \"}).query('Manquants > 0').sort_values('Manquants', ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if len(missing_df) > 0:\\n\",\n",
    "    \"    print(missing_df.to_string(index=False))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"Aucune valeur manquante !\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 4. Identification des variables\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"IDENTIFICATION DES VARIABLES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Variables à exclure de la modélisation\\n\",\n",
    "    \"vars_to_exclude = ['date_mutation', 'valeur_fonciere', 'adresse_nom_voie',\\n\",\n",
    "    \"                   'nom_commune', 'prix_m2']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Variables numériques\\n\",\n",
    "    \"numeric_vars = df.select_dtypes(include=[np.number]).columns.tolist()\\n\",\n",
    "    \"numeric_vars = [v for v in numeric_vars if v not in vars_to_exclude]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Variables catégorielles\\n\",\n",
    "    \"categorical_vars = df.select_dtypes(include=['object']).columns.tolist()\\n\",\n",
    "    \"categorical_vars = [v for v in categorical_vars if v not in vars_to_exclude]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nVariables numériques ({len(numeric_vars)}) :\\\")\\n\",\n",
    "    \"print(f\\\"  {', '.join(numeric_vars)}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nVariables catégorielles ({len(categorical_vars)}) :\\\")\\n\",\n",
    "    \"print(f\\\"  {', '.join(categorical_vars)}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 5. Analyse des corrélations (déjà fournie dans votre image)\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"CORRÉLATIONS AVEC LA CIBLE (prix_m2)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"correlations = df[numeric_vars + ['prix_m2']].corr()['prix_m2'].drop('prix_m2').sort_values(ascending=False)\\n\",\n",
    "    \"print(correlations)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nObservations importantes :\\\")\\n\",\n",
    "    \"print(\\\"  ✓ prix_median_m2 (0.75) : forte corrélation positive → variable importante\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"  ✓ nombre_pieces_principales (-0.30) : légère corrélation négative\\\")\\n\",\n",
    "    \"print(\\\"  ✓ code_postal/commune/dept : multicolinéarité parfaite → garder un seul\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 6. Préparation des features finales\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"PRÉPARATION DES FEATURES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer le dataframe de travail\\n\",\n",
    "    \"df_model = df.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Option 1 : Exclure les outliers extrêmes (recommandé pour débuter)\\n\",\n",
    "    \"print(\\\"\\\\nOption choisie : Exclusion des outliers extrêmes\\\")\\n\",\n",
    "    \"df_model = df_model[(df_model['prix_m2'] >= lower_bound) &\\n\",\n",
    "    \"                    (df_model['prix_m2'] <= upper_bound)]\\n\",\n",
    "    \"print(f\\\"Données restantes : {len(df_model):,} observations\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Gérer les valeurs manquantes\\n\",\n",
    "    \"# surface_terrain : remplir par 0 (appartements sans terrain)\\n\",\n",
    "    \"if 'surface_terrain' in df_model.columns:\\n\",\n",
    "    \"    df_model['surface_terrain'] = df_model['surface_terrain'].fillna(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# longitude/latitude : interpolation ou suppression (peu de valeurs manquantes)\\n\",\n",
    "    \"df_model = df_model.dropna(subset=['longitude', 'latitude'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Après nettoyage : {len(df_model):,} observations\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 7. DÉCOUPAGE TRAIN/TEST\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"DÉCOUPAGE TRAIN/TEST/VALIDATION\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Séparer features et target\\n\",\n",
