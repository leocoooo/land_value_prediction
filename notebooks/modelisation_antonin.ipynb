    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"xgb_train_time = time() - start_time\\n\",\n",
    "    \"print(f\\\"   ✓ Modèle entraîné en {xgb_train_time:.2f} secondes\\\")\\n\",\n",
    "    \"print(f\\\"   ✓ Meilleure itération : {xgb_model.best_iteration}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prédictions\\n\",\n",
    "    \"y_train_pred_xgb = xgb_model.predict(X_train_final)\\n\",\n",
    "    \"y_val_pred_xgb = xgb_model.predict(X_val_final)\\n\",\n",
    "    \"y_test_pred_xgb = xgb_model.predict(X_test_final)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Métriques\\n\",\n",
    "    \"xgb_results = []\\n\",\n",
    "    \"xgb_results.append(compute_metrics(y_train, y_train_pred_xgb, 'XGBoost', 'Train'))\\n\",\n",
    "    \"xgb_results.append(compute_metrics(y_val, y_val_pred_xgb, 'XGBoost', 'Validation'))\\n\",\n",
    "    \"xgb_results.append(compute_metrics(y_test, y_test_pred_xgb, 'XGBoost', 'Test'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"xgb_results_df = pd.DataFrame(xgb_results)\\n\",\n",
    "    \"print(\\\"\\\\n📊 Performances XGBoost :\\\\n\\\")\\n\",\n",
    "    \"print(xgb_results_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
