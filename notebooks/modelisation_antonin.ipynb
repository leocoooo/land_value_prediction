    "    \"      • Plus lent à entraîner\\n\",\n",
    "    \"      • Moins interprétable (boîte noire)\\n\",\n",
    "    \"      • Meilleur sur relations complexes\\n\",\n",
    "    \"\\\"\\\"\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 7. VISUALISATIONS\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
