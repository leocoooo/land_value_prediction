    "    \"ax5.grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Plot 6 : Comparaison R² ---\\n\",\n",
    "    \"ax6 = fig.add_subplot(gs[1, 2])\\n\",\n",
    "    \"models = ['Baseline', 'Optimisé']\\n\",\n",
    "    \"r2_scores = [baseline_xgb['R² Test'], optimized_xgb['R² Test']]\\n\",\n",
    "    \"colors = ['skyblue', 'orange']\\n\",\n",
    "    \"bars = ax6.bar(models, r2_scores, color=colors, alpha=0.7)\\n\",\n",
