    "    \"\\n\",\n",
    "    \"🚀 PROCHAINE ÉTAPE :\\n\",\n",
    "    \"   → Étape 5 : Deep Learning avec PyTorch\\n\",\n",
    "    \"   → Étape 6 : Analyse SHAP (interprétabilité)\\n\",\n",
    "    \"\\\"\\\"\\\")\\n\",\n",
