    "    \"   → Flexible et performant sur la plupart des cas\\n\",\n",
    "    \"\\\"\\\"\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"🎯 Kernel sélectionné : RBF (Radial Basis Function)\\\")\\n\",\n",
    "    \"print(\\\"   → Paramètres à optimiser : C (régularisation), epsilon, gamma\\\")\\n\",\n",
    "    \"\\n\",\n",
