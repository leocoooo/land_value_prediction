   "source": [
    "\"\"\"\n",
    "ÉTAPE 4.5 : OPTIMISATION HYPERPARAMÈTRES XGBOOST AVEC OPTUNA\n",
    "============================================================\n",
    "Objectif : Trouver les meilleurs hyperparamètres pour XGBoost\n",
    "\"\"\"\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
    "import xgboost as xgb\n",
    "import optuna\n",
    "from optuna.visualization import plot_optimization_history, plot_param_importances\n",
    "from time import time\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"OPTIMISATION XGBOOST AVEC OPTUNA\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# ============================================================================\n",
    "# 1. DÉFINITION DE LA FONCTION OBJECTIF\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n1️⃣  Configuration de l'optimisation Optuna...\")\n",
    "\n",
    "def objective(trial):\n",
    "    \"\"\"\n",
    "    Fonction objectif pour Optuna\n",
    "    On cherche à MINIMISER le RMSE sur le set de validation\n",
    "    \"\"\"\n",
    "\n",
    "    # Définir l'espace de recherche des hyperparamètres\n",
    "    params = {\n",
    "        # Paramètres de structure des arbres\n",
    "        'max_depth': trial.suggest_int('max_depth', 4, 15),\n",
    "        'min_child_weight': trial.suggest_int('min_child_weight', 1, 10),\n",
    "        'gamma': trial.suggest_float('gamma', 0, 5),\n",
    "\n",
    "        # Paramètres de boosting\n",
    "        'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.3, log=True),\n",
    "        'n_estimators': trial.suggest_int('n_estimators', 100, 1000, step=50),\n",
    "\n",
    "        # Paramètres de subsampling\n",
    "        'subsample': trial.suggest_float('subsample', 0.6, 1.0),\n",
    "        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.6, 1.0),\n",
    "        'colsample_bylevel': trial.suggest_float('colsample_bylevel', 0.6, 1.0),\n",
    "\n",
    "        # Régularisation\n",
    "        'reg_alpha': trial.suggest_float('reg_alpha', 0, 10),  # L1\n",
    "        'reg_lambda': trial.suggest_float('reg_lambda', 0, 10),  # L2\n",
    "\n",
    "        # Autres paramètres\n",
    "        'random_state': 42,\n",
    "        'n_jobs': -1,\n",
    "        'tree_method': 'hist',\n",
    "        'verbosity': 0\n",
    "    }\n",
    "\n",
    "    # Entraîner le modèle\n",
    "    model = xgb.XGBRegressor(**params)\n",
    "    model.fit(\n",
    "        X_train_final, y_train,\n",
    "        eval_set=[(X_val_final, y_val)],\n",
    "        early_stopping_rounds=50,\n",
    "        verbose=False\n",
    "    )\n",
    "\n",
    "    # Prédire sur validation\n",
    "    y_val_pred = model.predict(X_val_final)\n",
    "\n",
    "    # Calculer RMSE (métrique à minimiser)\n",
    "    rmse = np.sqrt(mean_squared_error(y_val, y_val_pred))\n",
    "\n",
    "    return rmse\n",
    "\n",
    "print(\"   ✓ Fonction objectif définie\")\n",
    "print(\"   • Métrique optimisée : RMSE sur validation\")\n",
    "print(\"   • Stratégie : Bayesian Optimization avec Tree-structured Parzen Estimator\")\n",
    "\n",
    "# ============================================================================\n",
    "# 2. LANCEMENT DE L'OPTIMISATION\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"2️⃣  LANCEMENT DE L'OPTIMISATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n⏳ Optimisation en cours... (cela peut prendre 5-15 minutes)\")\n",
    "print(\"   Vous pouvez réduire n_trials si c'est trop long\")\n",
    "\n",
    "# Créer l'étude Optuna\n",
    "study = optuna.create_study(\n",
    "    direction='minimize',  # On veut minimiser le RMSE\n",
    "    sampler=optuna.samplers.TPESampler(seed=42),\n",
    "    pruner=optuna.pruners.MedianPruner(n_warmup_steps=10)\n",
    ")\n",
    "\n",
    "# Lancer l'optimisation\n",
    "start_time = time()\n",
    "study.optimize(\n",
    "    objective,\n",
    "    n_trials=50,  # Nombre d'essais (augmenter à 100-200 pour meilleur résultat)\n",
    "    timeout=None,\n",
    "    show_progress_bar=True,\n",
    "    n_jobs=1  # Parallélisation au niveau d'Optuna\n",
    ")\n",
    "optim_time = time() - start_time\n",
    "\n",
    "print(f\"\\n   ✓ Optimisation terminée en {optim_time/60:.2f} minutes\")\n",
    "print(f\"   • Nombre de trials complétés : {len(study.trials)}\")\n",
    "print(f\"   • Meilleur RMSE : {study.best_value:.2f} €/m²\")\n",
    "\n",
    "# ============================================================================\n",
    "# 3. MEILLEURS HYPERPARAMÈTRES\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"3️⃣  MEILLEURS HYPERPARAMÈTRES TROUVÉS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "best_params = study.best_params\n",
    "print(\"\\n📋 Hyperparamètres optimaux :\\n\")\n",
    "for param, value in best_params.items():\n",
    "    print(f\"   • {param:20s} : {value}\")\n",
    "\n",
    "# ============================================================================\n",
    "# 4. ENTRAÎNEMENT DU MODÈLE OPTIMISÉ\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"4️⃣  ENTRAÎNEMENT DU MODÈLE OPTIMISÉ\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\nEntraînement avec les meilleurs hyperparamètres...\")\n",
    "\n",
    "# Créer le modèle avec les meilleurs paramètres\n",
    "best_xgb = xgb.XGBRegressor(\n",
    "    **best_params,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    tree_method='hist'\n",
    ")\n",
    "\n",
    "# Entraîner\n",
    "best_xgb.fit(\n",
    "    X_train_final, y_train,\n",
    "    eval_set=[(X_val_final, y_val)],\n",
    "    early_stopping_rounds=50,\n",
    "    verbose=False\n",
    ")\n",
    "\n",
    "print(f\"   ✓ Modèle optimisé entraîné\")\n",
    "print(f\"   • Meilleure itération : {best_xgb.best_iteration}\")\n",
    "\n",
    "# ============================================================================\n",
    "# 5. ÉVALUATION COMPLÈTE\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"5️⃣  ÉVALUATION DU MODÈLE OPTIMISÉ\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Prédictions\n",
    "y_train_pred_opt = best_xgb.predict(X_train_final)\n",
    "y_val_pred_opt = best_xgb.predict(X_val_final)\n",
    "y_test_pred_opt = best_xgb.predict(X_test_final)\n",
    "\n",
    "# Calcul des métriques\n",
    "def compute_all_metrics(y_true, y_pred, dataset_name):\n",
    "    \"\"\"Calcule toutes les métriques de régression\"\"\"\n",
    "    mse = mean_squared_error(y_true, y_pred)\n",
    "    rmse = np.sqrt(mse)\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\n",
    "\n",
    "    # Médiane de l'erreur absolue\n",
    "    median_ae = np.median(np.abs(y_true - y_pred))\n",
    "\n",
    "    # Erreur maximale\n",
    "    max_error = np.max(np.abs(y_true - y_pred))\n",
    "\n",
    "    return {\n",
    "        'Dataset': dataset_name,\n",
    "        'R²': r2,\n",
    "        'RMSE': rmse,\n",
    "        'MAE': mae,\n",
    "        'MAPE (%)': mape,\n",
    "        'Median AE': median_ae,\n",
    "        'Max Error': max_error\n",
    "    }\n",
    "\n",
    "results_optimized = []\n",
    "results_optimized.append(compute_all_metrics(y_train, y_train_pred_opt, 'Train'))\n",
    "results_optimized.append(compute_all_metrics(y_val, y_val_pred_opt, 'Validation'))\n",
    "results_optimized.append(compute_all_metrics(y_test, y_test_pred_opt, 'Test'))\n",
    "\n",
    "results_opt_df = pd.DataFrame(results_optimized)\n",
    "\n",
    "print(\"\\n📊 Performances du modèle OPTIMISÉ :\\n\")\n",
    "print(results_opt_df.to_string(index=False))\n",
    "\n",
    "# ============================================================================\n",
    "# 6. COMPARAISON AVANT/APRÈS OPTIMISATION\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"6️⃣  COMPARAISON AVANT/APRÈS OPTIMISATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Résultats du modèle de base (de l'étape 4)\n",
    "baseline_xgb = {\n",
    "    'Modèle': 'XGBoost Baseline',\n",
    "    'R² Test': 0.7331,\n",
    "    'RMSE Test': 1852.22\n",
    "}\n",
    "\n",
    "optimized_xgb = {\n",
    "    'Modèle': 'XGBoost Optimisé',\n",
    "    'R² Test': results_optimized[2]['R²'],\n",
    "    'RMSE Test': results_optimized[2]['RMSE']\n",
    "}\n",
    "\n",
    "comparison = pd.DataFrame([baseline_xgb, optimized_xgb])\n",
    "print(\"\\n📊 Comparaison des performances :\\n\")\n",
    "print(comparison.to_string(index=False))\n",
    "\n",
    "# Calcul du gain\n",
    "r2_gain = (optimized_xgb['R² Test'] - baseline_xgb['R² Test']) / baseline_xgb['R² Test'] * 100\n",
    "rmse_gain = (baseline_xgb['RMSE Test'] - optimized_xgb['RMSE Test']) / baseline_xgb['RMSE Test'] * 100\n",
    "\n",
    "print(f\"\\n📈 Gains de l'optimisation :\")\n",
    "print(f\"   • R² : {r2_gain:+.2f}%\")\n",
    "print(f\"   • RMSE : {rmse_gain:+.2f}%\")\n",
    "\n",
    "if rmse_gain > 0:\n",
    "    print(f\"   ✓ Le modèle optimisé est MEILLEUR de {rmse_gain:.2f}%\")\n",
    "else:\n",
    "    print(f\"   ⚠️  Le modèle baseline était déjà très bon (gain marginal)\")\n",
    "\n",
    "# ============================================================================\n",
    "# 7. MÉTRIQUES COMPLÉMENTAIRES (Courbe de calibration)\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"7️⃣  MÉTRIQUES COMPLÉMENTAIRES\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Pour la régression, on ne peut pas calculer l'AUC directement\n",
    "# Mais on peut créer des métriques similaires :\n",
    "\n",
    "# 1. Coefficient de corrélation de Spearman (rang)\n",
    "from scipy.stats import spearmanr, pearsonr\n",
    "\n",
    "spearman_corr, _ = spearmanr(y_test, y_test_pred_opt)\n",
    "pearson_corr, _ = pearsonr(y_test, y_test_pred_opt)\n",
    "\n",
    "print(\"\\n📊 Corrélations prédictions vs valeurs réelles :\")\n",
    "print(f\"   • Corrélation de Pearson  : {pearson_corr:.4f}\")\n",
    "print(f\"   • Corrélation de Spearman : {spearman_corr:.4f}\")\n",
    "\n",
    "# 2. Proportion de prédictions dans un intervalle acceptable\n",
    "tolerance_10pct = np.mean(np.abs((y_test - y_test_pred_opt) / y_test) <= 0.10) * 100\n",
    "tolerance_20pct = np.mean(np.abs((y_test - y_test_pred_opt) / y_test) <= 0.20) * 100\n",
    "tolerance_30pct = np.mean(np.abs((y_test - y_test_pred_opt) / y_test) <= 0.30) * 100\n",
    "\n",
    "print(\"\\n📊 Précision des prédictions :\")\n",
    "print(f\"   • Prédictions à ±10% : {tolerance_10pct:.2f}%\")\n",
    "print(f\"   • Prédictions à ±20% : {tolerance_20pct:.2f}%\")\n",
    "print(f\"   • Prédictions à ±30% : {tolerance_30pct:.2f}%\")\n",
    "\n",
    "# 3. Si vous voulez vraiment une métrique type AUC :\n",
    "# Transformons en problème de classification binaire (prix > médiane)\n",
    "y_test_binary = (y_test > y_test.median()).astype(int)\n",
    "y_test_pred_binary = (y_test_pred_opt > y_test.median()).astype(int)\n",
    "\n",
    "from sklearn.metrics import roc_auc_score, accuracy_score\n",
    "auc_score = roc_auc_score(y_test_binary, y_test_pred_opt)\n",
    "accuracy = accuracy_score(y_test_binary, y_test_pred_binary)\n",
    "\n",
    "print(\"\\n📊 Métriques de classification (prix > médiane) :\")\n",
    "print(f\"   • AUC-ROC : {auc_score:.4f}\")\n",
    "print(f\"   • Accuracy : {accuracy:.4f}\")\n",
    "\n",
    "print(\"\\n💡 Note : L'AUC en régression n'est pas standard.\")\n",
    "print(\"   Les corrélations et intervalles de tolérance sont plus pertinents.\")\n",
    "\n",
    "# ============================================================================\n",
    "# 8. VISUALISATIONS\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"8️⃣  VISUALISATIONS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "fig = plt.figure(figsize=(18, 10))\n",
    "gs = fig.add_gridspec(2, 3, hspace=0.3, wspace=0.3)\n",
    "\n",
    "# --- Plot 1 : Historique d'optimisation ---\n",
    "ax1 = fig.add_subplot(gs[0, 0])\n",
    "trials_df = study.trials_dataframe()\n",
    "ax1.plot(trials_df['number'], trials_df['value'], 'o-', alpha=0.6)\n",
    "ax1.axhline(y=study.best_value, color='r', linestyle='--',\n",
    "           label=f'Meilleur: {study.best_value:.2f}')\n",
    "ax1.set_xlabel('Numéro du trial')\n",
    "ax1.set_ylabel('RMSE (€/m²)')\n",
    "ax1.set_title('Historique d\\'optimisation Optuna')\n",
    "ax1.legend()\n",
    "ax1.grid(alpha=0.3)\n",
    "\n",
    "# --- Plot 2 : Importance des hyperparamètres ---\n",
    "ax2 = fig.add_subplot(gs[0, 1])\n",
    "importance = optuna.importance.get_param_importances(study)\n",
    "params = list(importance.keys())[:10]\n",
    "values = [importance[p] for p in params]\n",
    "ax2.barh(range(len(params)), values, color='steelblue', alpha=0.7)\n",
    "ax2.set_yticks(range(len(params)))\n",
    "ax2.set_yticklabels(params)\n",
    "ax2.set_xlabel('Importance')\n",
    "ax2.set_title('Importance des Hyperparamètres')\n",
    "ax2.grid(alpha=0.3, axis='x')\n",
    "\n",
    "# --- Plot 3 : Distribution des valeurs RMSE ---\n",
    "ax3 = fig.add_subplot(gs[0, 2])\n",
    "ax3.hist(trials_df['value'], bins=30, edgecolor='black', alpha=0.7, color='steelblue')\n",
    "ax3.axvline(x=study.best_value, color='r', linestyle='--', linewidth=2,\n",
    "           label=f'Meilleur: {study.best_value:.2f}')\n",
    "ax3.set_xlabel('RMSE (€/m²)')\n",
    "ax3.set_ylabel('Nombre de trials')\n",
    "ax3.set_title('Distribution des RMSE')\n",
    "ax3.legend()\n",
    "ax3.grid(alpha=0.3)\n",
    "\n",
    "# --- Plot 4 : Prédictions vs Réelles ---\n",
    "ax4 = fig.add_subplot(gs[1, 0])\n",
    "sample_size = 5000\n",
    "sample_idx = np.random.choice(len(y_test), sample_size, replace=False)\n",
    "ax4.scatter(y_test.iloc[sample_idx], y_test_pred_opt[sample_idx],\n",
    "           alpha=0.3, s=10, color='orange')\n",
    "ax4.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()],\n",
    "        'r--', lw=2, label='Prédiction parfaite')\n",
    "ax4.set_xlabel('Prix réel (€/m²)')\n",
    "ax4.set_ylabel('Prix prédit (€/m²)')\n",
    "ax4.set_title('Prédictions vs Réelles (Test) - Modèle Optimisé')\n",
    "ax4.legend()\n",
    "ax4.grid(alpha=0.3)\n",
    "\n",
    "# --- Plot 5 : Résidus ---\n",
    "ax5 = fig.add_subplot(gs[1, 1])\n",
    "residuals = y_test - y_test_pred_opt\n",
    "ax5.scatter(y_test_pred_opt[sample_idx], residuals.iloc[sample_idx],\n",
    "           alpha=0.3, s=10, color='orange')\n",
    "ax5.axhline(y=0, color='r', linestyle='--', linewidth=2)\n",
    "ax5.set_xlabel('Valeurs prédites (€/m²)')\n",
    "ax5.set_ylabel('Résidus (€/m²)')\n",
    "ax5.set_title('Résidus vs Prédictions')\n",
    "ax5.grid(alpha=0.3)\n",
    "\n",
    "# --- Plot 6 : Comparaison R² ---\n",
    "ax6 = fig.add_subplot(gs[1, 2])\n",
    "models = ['Baseline', 'Optimisé']\n",
    "r2_scores = [baseline_xgb['R² Test'], optimized_xgb['R² Test']]\n",
    "colors = ['skyblue', 'orange']\n",
    "bars = ax6.bar(models, r2_scores, color=colors, alpha=0.7)\n",
    "ax6.set_ylabel('R² Score')\n",
    "ax6.set_title('Comparaison R² (Test)')\n",
    "ax6.set_ylim([0.5, 1])\n",
    "ax6.grid(alpha=0.3, axis='y')\n",
    "for bar, score in zip(bars, r2_scores):\n",
    "    height = bar.get_height()\n",
    "    ax6.text(bar.get_x() + bar.get_width()/2., height,\n",
    "            f'{score:.4f}', ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "plt.suptitle('ANALYSE DE L\\'OPTIMISATION XGBOOST', fontsize=16, fontweight='bold')\n",
    "plt.show()\n",
    "\n",
    "print(\"   ✓ Visualisations générées\")\n",
    "\n",
    "# ============================================================================\n",
    "# 9. RÉSUMÉ FINAL\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"✓ OPTIMISATION TERMINÉE - RÉSUMÉ\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(f\"\"\"\n",
    "⏱️  TEMPS D'OPTIMISATION : {optim_time/60:.2f} minutes\n",
    "   • {len(study.trials)} trials testés\n",
    "   • Meilleur trial : #{study.best_trial.number}\n",
    "\n",
    "🎯 PERFORMANCES FINALES (Test) :\n",
    "   • R² = {results_optimized[2]['R²']:.4f}\n",
    "   • RMSE = {results_optimized[2]['RMSE']:.2f} €/m²\n",
    "   • MAE = {results_optimized[2]['MAE']:.2f} €/m²\n",
    "   • MAPE = {results_optimized[2]['MAPE (%)']:.2f}%\n",
    "\n",
    "📈 GAINS vs BASELINE :\n",
    "   • R² : {r2_gain:+.2f}%\n",
    "   • RMSE : {rmse_gain:+.2f}%\n",
    "\n",
    "🎲 MEILLEURS HYPERPARAMÈTRES :\n",
    "   • max_depth : {best_params['max_depth']}\n",
    "   • learning_rate : {best_params['learning_rate']:.4f}\n",
    "   • n_estimators : {best_params['n_estimators']}\n",
    "   • subsample : {best_params['subsample']:.3f}\n",
    "   • colsample_bytree : {best_params['colsample_bytree']:.3f}\n",
    "\n",
    "📊 MÉTRIQUES COMPLÉMENTAIRES :\n",
    "   • Corrélation Spearman : {spearman_corr:.4f}\n",
    "   • Prédictions à ±20% : {tolerance_20pct:.2f}%\n",
    "   • AUC (classification) : {auc_score:.4f}\n",
    "\n",
    "🚀 PROCHAINE ÉTAPE :\n",
    "   → Étape 5 : Deep Learning avec PyTorch\n",
    "   → Étape 6 : Analyse SHAP (interprétabilité)\n",
    "\"\"\")\n",
    "\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Sauvegarder\n",
    "results_optimized_xgb = {\n",
    "    'model': best_xgb,\n",
    "    'study': study,\n",
    "    'best_params': best_params,\n",
    "    'predictions': {'train': y_train_pred_opt, 'val': y_val_pred_opt, 'test': y_test_pred_opt},\n",
    "    'metrics': results_opt_df\n",
    "}\n",
    "\n",
    "print(\"\\n💾 Résultats sauvegardés dans : results_optimized_xgb\")"
   ],
