    "# Statistiques descriptives\n",
    "print(\"\\n📊 Statistiques des contributions SHAP (top 10 features) :\\n\")\n",
    "top_10_features = shap_importance.head(10)['Feature'].values\n",
    "stats_shap = shap_df[top_10_features].describe().T\n",
    "stats_shap['mean_abs'] = shap_df[top_10_features].abs().mean()\n",
    "stats_shap = stats_shap.sort_values('mean_abs', ascending=False)\n",
    "print(stats_shap[['mean', 'std', 'min', 'max', 'mean_abs']].round(2))\n",
    "\n",
    "# Contribution positive vs négative\n",
    "print(\"\\n📊 Répartition des contributions (top 10 features) :\\n\")\n",
    "contribution_analysis = pd.DataFrame({\n",
    "    'Feature': top_10_features,\n",
    "    'Contrib_Positive (%)': [(shap_df[f] > 0).sum() / len(shap_df) * 100 for f in top_10_features],\n",
    "    'Contrib_Negative (%)': [(shap_df[f] < 0).sum() / len(shap_df) * 100 for f in top_10_features],\n",
    "    'Contrib_Mean_Positive': [shap_df.loc[shap_df[f] > 0, f].mean() for f in top_10_features],\n",
    "    'Contrib_Mean_Negative': [shap_df.loc[shap_df[f] < 0, f].mean() for f in top_10_features]\n",
    "})\n",
    "print(contribution_analysis.round(2).to_string(index=False))\n",
