    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# ÉTAPE 3 : MODÈLE DE RÉGRESSION LINÉAIRE (MCO)\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"from sklearn.linear_model import LinearRegression, Ridge, Lasso\\n\",\n",
    "    \"from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\\n\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"ÉTAPE 3 : MODÈLE DE RÉGRESSION LINÉAIRE (MCO)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. ENTRAÎNEMENT DU MODÈLE MCO\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n1️⃣  Entraînement du modèle MCO...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"model_ols = LinearRegression()\\n\",\n",
    "    \"model_ols.fit(X_train_scaled, y_train)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"   ✓ Modèle entraîné\\\")\\n\",\n",
    "    \"print(f\\\"   • Nombre de features     : {X_train_scaled.shape[1]}\\\")\\n\",\n",
    "    \"print(f\\\"   • Nombre d'observations  : {X_train_scaled.shape[0]:,}\\\")\\n\",\n",
    "    \"print(f\\\"   • Intercept (constante)  : {model_ols.intercept_:.2f} €/m²\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 2. PRÉDICTIONS\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n2️⃣  Génération des prédictions...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_train_pred = model_ols.predict(X_train_scaled)\\n\",\n",
    "    \"y_val_pred = model_ols.predict(X_val_scaled)\\n\",\n",
    "    \"y_test_pred = model_ols.predict(X_test_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"   ✓ Prédictions générées pour train, validation et test\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 3. ÉVALUATION DES PERFORMANCES\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"3️⃣  ÉVALUATION DES PERFORMANCES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate_model(y_true, y_pred, dataset_name):\\n\",\n",
    "    \"    \\\"\\\"\\\"Calcule les métriques de performance\\\"\\\"\\\"\\n\",\n",
    "    \"    mse = mean_squared_error(y_true, y_pred)\\n\",\n",
    "    \"    rmse = np.sqrt(mse)\\n\",\n",
    "    \"    mae = mean_absolute_error(y_true, y_pred)\\n\",\n",
    "    \"    r2 = r2_score(y_true, y_pred)\\n\",\n",
    "    \"    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'Dataset': dataset_name,\\n\",\n",
    "    \"        'RMSE': rmse,\\n\",\n",
    "    \"        'MAE': mae,\\n\",\n",
    "    \"        'R²': r2,\\n\",\n",
    "    \"        'MAPE (%)': mape\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calcul des métriques\\n\",\n",
    "    \"results = []\\n\",\n",
    "    \"results.append(evaluate_model(y_train, y_train_pred, 'Train'))\\n\",\n",
    "    \"results.append(evaluate_model(y_val, y_val_pred, 'Validation'))\\n\",\n",
    "    \"results.append(evaluate_model(y_test, y_test_pred, 'Test'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_df = pd.DataFrame(results)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Métriques de performance :\\\\n\\\")\\n\",\n",
    "    \"print(results_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Interprétation\\n\",\n",
    "    \"print(\\\"\\\\n💡 Interprétation :\\\")\\n\",\n",
    "    \"print(f\\\"   • R² Test = {results_df.loc[2, 'R²']:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"     → Le modèle explique {results_df.loc[2, 'R²']*100:.2f}% de la variance\\\")\\n\",\n",
    "    \"print(f\\\"   • RMSE Test = {results_df.loc[2, 'RMSE']:.2f} €/m²\\\")\\n\",\n",
    "    \"print(f\\\"     → Erreur moyenne de ±{results_df.loc[2, 'RMSE']:.0f} €/m²\\\")\\n\",\n",
    "    \"print(f\\\"   • MAE Test = {results_df.loc[2, 'MAE']:.2f} €/m²\\\")\\n\",\n",
    "    \"print(f\\\"     → Erreur absolue moyenne de {results_df.loc[2, 'MAE']:.0f} €/m²\\\")\\n\",\n",
    "    \"print(f\\\"   • MAPE Test = {results_df.loc[2, 'MAPE (%)']:.2f}%\\\")\\n\",\n",
    "    \"print(f\\\"     → Erreur relative moyenne de {results_df.loc[2, 'MAPE (%)']:.1f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Check overfitting\\n\",\n",
    "    \"train_r2 = results_df.loc[0, 'R²']\\n\",\n",
    "    \"val_r2 = results_df.loc[1, 'R²']\\n\",\n",
    "    \"test_r2 = results_df.loc[2, 'R²']\\n\",\n",
    "    \"diff_r2 = train_r2 - val_r2\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n🔍 Analyse du surapprentissage :\\\")\\n\",\n",
    "    \"print(f\\\"   • R² Train          : {train_r2:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"   • R² Validation     : {val_r2:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"   • R² Test           : {test_r2:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"   • Différence (Train - Val) : {diff_r2:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"if diff_r2 < 0.05:\\n\",\n",
    "    \"    print(\\\"   ✓ Pas de surapprentissage détecté\\\")\\n\",\n",
    "    \"elif diff_r2 < 0.10:\\n\",\n",
    "    \"    print(\\\"   ⚠️  Léger surapprentissage\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"   ❌ Surapprentissage important\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 4. ANALYSE DES COEFFICIENTS (INTERPRÉTABILITÉ)\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"4️⃣  ANALYSE DES COEFFICIENTS (INTERPRÉTABILITÉ)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer un DataFrame avec les coefficients\\n\",\n",
    "    \"coefficients = pd.DataFrame({\\n\",\n",
    "    \"    'Feature': X_train_scaled.columns,\\n\",\n",
