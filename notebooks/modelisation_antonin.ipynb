    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Shapleyyy\",\n",
    "   \"id\": \"2f2799d0677d35a8\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"ÉTAPE 6 : ANALYSE SHAP - INTERPRÉTABILITÉ AVANCÉE\\n\",\n",
    "    \"==================================================\\n\",\n",
    "    \"Objectif : Comprendre comment le modèle XGBoost prend ses décisions\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"import shap\\n\",\n",
    "    \"from time import time\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"ÉTAPE 6 : ANALYSE SHAP (SHapley Additive exPlanations)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\"\\\"\\n\",\n",
    "    \"💡 SHAP explique les prédictions en calculant la contribution de chaque feature\\n\",\n",
    "    \"   Basé sur la théorie des jeux coopératifs (valeurs de Shapley)\\n\",\n",
    "    \"\\\"\\\"\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. INITIALISATION DE L'EXPLAINER SHAP\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"1️⃣  INITIALISATION DE L'EXPLAINER SHAP\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Création de l'explainer (peut prendre 1-2 minutes)...\\\")\\n\",\n",
    "    \"start_time = time()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Pour XGBoost, on utilise TreeExplainer (très rapide et exact)\\n\",\n",
    "    \"explainer = shap.TreeExplainer(best_xgb)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"   ✓ Explainer créé en {time() - start_time:.2f} secondes\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 2. CALCUL DES VALEURS SHAP\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"2️⃣  CALCUL DES VALEURS SHAP\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# On calcule sur un échantillon du test pour des raisons de performance\\n\",\n",
    "    \"# Pour l'analyse complète, utilisez tout le test set\\n\",\n",
    "    \"sample_size = 2000  # Augmenter à 10000 ou len(X_test_final) pour analyse complète\\n\",\n",
    "    \"print(f\\\"\\\\n📊 Calcul des valeurs SHAP sur {sample_size} échantillons du test set...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Échantillonnage stratifié par quartile de prix\\n\",\n",
    "    \"y_test_quartiles = pd.qcut(y_test, q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])\\n\",\n",
    "    \"sample_indices = []\\n\",\n",
    "    \"for quartile in ['Q1', 'Q2', 'Q3', 'Q4']:\\n\",\n",
    "    \"    quartile_indices = y_test[y_test_quartiles == quartile].index\\n\",\n",
    "    \"    n_samples = min(sample_size // 4, len(quartile_indices))\\n\",\n",
    "    \"    sample_indices.extend(np.random.choice(quartile_indices, n_samples, replace=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_test_sample = X_test_final.loc[sample_indices]\\n\",\n",
    "    \"y_test_sample = y_test.loc[sample_indices]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"   ⏳ Calcul en cours...\\\")\\n\",\n",
    "    \"start_time = time()\\n\",\n",
    "    \"shap_values = explainer.shap_values(X_test_sample)\\n\",\n",
    "    \"calc_time = time() - start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"   ✓ Valeurs SHAP calculées en {calc_time:.2f} secondes\\\")\\n\",\n",
    "    \"print(f\\\"   • Shape des valeurs SHAP : {shap_values.shape}\\\")\\n\",\n",
    "    \"print(f\\\"   • Valeur de base (expected value) : {explainer.expected_value:.2f} €/m²\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 3. GLOBAL FEATURE IMPORTANCE\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"3️⃣  IMPORTANCE GLOBALE DES FEATURES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calculer l'importance moyenne absolue\\n\",\n",
    "    \"shap_importance = pd.DataFrame({\\n\",\n",
    "    \"    'Feature': X_test_sample.columns,\\n\",\n",
    "    \"    'Mean_|SHAP|': np.abs(shap_values).mean(axis=0)\\n\",\n",
    "    \"}).sort_values('Mean_|SHAP|', ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Top 20 features par importance SHAP :\\\\n\\\")\\n\",\n",
    "    \"print(shap_importance.head(20).to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 4. VISUALISATIONS SHAP\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"4️⃣  VISUALISATIONS SHAP\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Génération des visualisations...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Figure 1 : Summary Plot (le plus important) ---\\n\",\n",
    "    \"print(\\\"\\\\n   1/7 - Summary Plot (vue d'ensemble)...\\\")\\n\",\n",
    "    \"fig1, ax1 = plt.subplots(figsize=(12, 10))\\n\",\n",
    "    \"shap.summary_plot(\\n\",\n",
    "    \"    shap_values,\\n\",\n",
    "    \"    X_test_sample,\\n\",\n",
    "    \"    max_display=20,\\n\",\n",
    "    \"    show=False,\\n\",\n",
    "    \"    plot_size=(12, 10)\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.title('SHAP Summary Plot - Impact des Features', fontsize=14, fontweight='bold', pad=20)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Figure 2 : Bar Plot (importance agrégée) ---\\n\",\n",
    "    \"print(\\\"   2/7 - Bar Plot (importance moyenne)...\\\")\\n\",\n",
    "    \"fig2, ax2 = plt.subplots(figsize=(10, 8))\\n\",\n",
    "    \"shap.summary_plot(\\n\",\n",
    "    \"    shap_values,\\n\",\n",
    "    \"    X_test_sample,\\n\",\n",
    "    \"    plot_type='bar',\\n\",\n",
    "    \"    max_display=20,\\n\",\n",
    "    \"    show=False\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.title('SHAP Bar Plot - Importance Moyenne des Features', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Figure 3 : Dependence Plots (Top 4 features) ---\\n\",\n",
    "    \"print(\\\"   3/7 - Dependence Plots (top 4 features)...\\\")\\n\",\n",
    "    \"fig3, axes = plt.subplots(2, 2, figsize=(16, 12))\\n\",\n",
    "    \"top_features = shap_importance.head(4)['Feature'].values\\n\",\n",
    "    \"\\n\",\n",
    "    \"for idx, feature in enumerate(top_features):\\n\",\n",
    "    \"    ax = axes[idx // 2, idx % 2]\\n\",\n",
    "    \"    shap.dependence_plot(\\n\",\n",
    "    \"        feature,\\n\",\n",
    "    \"        shap_values,\\n\",\n",
    "    \"        X_test_sample,\\n\",\n",
    "    \"        ax=ax,\\n\",\n",
    "    \"        show=False\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.set_title(f'Dependence Plot - {feature}', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('SHAP Dependence Plots - Top 4 Features', fontsize=14, fontweight='bold', y=0.995)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Figure 4 : Force Plot (exemple individuel) ---\\n\",\n",
    "    \"print(\\\"   4/7 - Force Plots (prédictions individuelles)...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Sélectionner 3 exemples : sous-estimé, bien prédit, surestimé\\n\",\n",
    "    \"residuals = y_test_sample - best_xgb.predict(X_test_sample)\\n\",\n",
    "    \"idx_underpredict = residuals.idxmax()  # Le plus sous-estimé\\n\",\n",
    "    \"idx_overpredict = residuals.idxmin()   # Le plus surestimé\\n\",\n",
    "    \"idx_good = residuals.abs().idxmin()    # Le mieux prédit\\n\",\n",
    "    \"\\n\",\n",
    "    \"examples = {\\n\",\n",
    "    \"    'Sous-estimé': idx_underpredict,\\n\",\n",
    "    \"    'Bien prédit': idx_good,\\n\",\n",
    "    \"    'Sur-estimé': idx_overpredict\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig4, axes = plt.subplots(3, 1, figsize=(16, 12))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for idx, (label, example_idx) in enumerate(examples.items()):\\n\",\n",
    "    \"    sample_idx = X_test_sample.index.get_loc(example_idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    real_price = y_test_sample.loc[example_idx]\\n\",\n",
    "    \"    pred_price = best_xgb.predict(X_test_sample.loc[[example_idx]])[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax = axes[idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Créer le force plot\\n\",\n",
    "    \"    shap.force_plot(\\n\",\n",
    "    \"        explainer.expected_value,\\n\",\n",
    "    \"        shap_values[sample_idx],\\n\",\n",
    "    \"        X_test_sample.iloc[sample_idx],\\n\",\n",
    "    \"        matplotlib=True,\\n\",\n",
    "    \"        show=False,\\n\",\n",
    "    \"        figsize=(16, 3)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.sca(ax)\\n\",\n",
    "    \"    plt.title(f'{label} - Réel: {real_price:.0f} €/m² | Prédit: {pred_price:.0f} €/m² | Erreur: {pred_price-real_price:+.0f} €/m²',\\n\",\n",
    "    \"             fontsize=11, fontweight='bold')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('SHAP Force Plots - Exemples de Prédictions', fontsize=14, fontweight='bold', y=0.995)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Figure 5 : Waterfall Plot (meilleur exemple) ---\\n\",\n",
    "    \"print(\\\"   5/7 - Waterfall Plot (meilleur prédiction)...\\\")\\n\",\n",
    "    \"sample_idx_good = X_test_sample.index.get_loc(idx_good)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig5, ax5 = plt.subplots(figsize=(10, 8))\\n\",\n",
    "    \"shap.waterfall_plot(\\n\",\n",
    "    \"    shap.Explanation(\\n\",\n",
    "    \"        values=shap_values[sample_idx_good],\\n\",\n",
    "    \"        base_values=explainer.expected_value,\\n\",\n",
    "    \"        data=X_test_sample.iloc[sample_idx_good],\\n\",\n",
    "    \"        feature_names=X_test_sample.columns.tolist()\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    max_display=15,\\n\",\n",
    "    \"    show=False\\n\",\n",
    "    \")\\n\",\n",
    "    \"real = y_test_sample.iloc[sample_idx_good]\\n\",\n",
    "    \"pred = best_xgb.predict(X_test_sample.iloc[[sample_idx_good]])[0]\\n\",\n",
    "    \"plt.title(f'Waterfall Plot - Bien Prédit\\\\nRéel: {real:.0f} €/m² | Prédit: {pred:.0f} €/m²',\\n\",\n",
    "    \"         fontsize=12, fontweight='bold')\\n\",\n",
