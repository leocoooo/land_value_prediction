    "    \"plt.suptitle('ANALYSE DE L\\\\'OPTIMISATION XGBOOST', fontsize=16, fontweight='bold')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"   ✓ Visualisations générées\\\")\\n\",\n",
    "    \"\\n\",\n",
