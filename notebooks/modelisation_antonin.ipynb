    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"ÉTAPE 4 : MODÈLES D'ARBRES - RANDOM FOREST & XGBOOST\\n\",\n",
    "    \"=====================================================\\n\",\n",
    "    \"Objectif : Capturer les non-linéarités et améliorer significativement les performances\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"from sklearn.ensemble import RandomForestRegressor\\n\",\n",
    "    \"from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\\n\",\n",
    "    \"import xgboost as xgb\\n\",\n",
    "    \"from time import time\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"ÉTAPE 4 : MODÈLES D'ARBRES (RANDOM FOREST & XGBOOST)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# On utilise les données NON standardisées (meilleur pour les arbres)\\n\",\n",
    "    \"print(\\\"\\\\n💡 Note : Les modèles d'arbres utilisent les données NON standardisées\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. RANDOM FOREST - MODÈLE DE BASE\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"1️⃣  RANDOM FOREST - MODÈLE DE BASE\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nEntraînement du Random Forest...\\\")\\n\",\n",
    "    \"start_time = time()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Paramètres de base (pas encore optimisés)\\n\",\n",
    "    \"rf_model = RandomForestRegressor(\\n\",\n",
    "    \"    n_estimators=100,          # Nombre d'arbres\\n\",\n",
    "    \"    max_depth=20,              # Profondeur maximale\\n\",\n",
    "    \"    min_samples_split=50,      # Minimum d'échantillons pour split\\n\",\n",
    "    \"    min_samples_leaf=20,       # Minimum d'échantillons par feuille\\n\",\n",
    "    \"    max_features='sqrt',       # Nombre de features par split\\n\",\n",
    "    \"    n_jobs=-1,                 # Utiliser tous les CPU\\n\",\n",
    "    \"    random_state=42,\\n\",\n",
    "    \"    verbose=0\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"rf_model.fit(X_train_final, y_train)\\n\",\n",
    "    \"rf_train_time = time() - start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"   ✓ Modèle entraîné en {rf_train_time:.2f} secondes\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prédictions\\n\",\n",
    "    \"y_train_pred_rf = rf_model.predict(X_train_final)\\n\",\n",
    "    \"y_val_pred_rf = rf_model.predict(X_val_final)\\n\",\n",
    "    \"y_test_pred_rf = rf_model.predict(X_test_final)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Métriques\\n\",\n",
    "    \"def compute_metrics(y_true, y_pred, model_name, dataset_name):\\n\",\n",
    "    \"    \\\"\\\"\\\"Calcule toutes les métriques\\\"\\\"\\\"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'Modèle': model_name,\\n\",\n",
    "    \"        'Dataset': dataset_name,\\n\",\n",
    "    \"        'R²': r2_score(y_true, y_pred),\\n\",\n",
    "    \"        'RMSE': np.sqrt(mean_squared_error(y_true, y_pred)),\\n\",\n",
    "    \"        'MAE': mean_absolute_error(y_true, y_pred),\\n\",\n",
    "    \"        'MAPE (%)': np.mean(np.abs((y_true - y_pred) / y_true)) * 100\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"rf_results = []\\n\",\n",
    "    \"rf_results.append(compute_metrics(y_train, y_train_pred_rf, 'Random Forest', 'Train'))\\n\",\n",
    "    \"rf_results.append(compute_metrics(y_val, y_val_pred_rf, 'Random Forest', 'Validation'))\\n\",\n",
    "    \"rf_results.append(compute_metrics(y_test, y_test_pred_rf, 'Random Forest', 'Test'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"rf_results_df = pd.DataFrame(rf_results)\\n\",\n",
    "    \"print(\\\"\\\\n📊 Performances Random Forest :\\\\n\\\")\\n\",\n",
    "    \"print(rf_results_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 2. XGBOOST - MODÈLE DE BASE\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"2️⃣  XGBOOST - MODÈLE DE BASE\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nEntraînement du XGBoost...\\\")\\n\",\n",
    "    \"start_time = time()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Paramètres de base\\n\",\n",
    "    \"xgb_model = xgb.XGBRegressor(\\n\",\n",
