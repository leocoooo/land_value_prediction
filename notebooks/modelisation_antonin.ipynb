    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"6️⃣  ANALYSE STATISTIQUE DES CONTRIBUTIONS SHAP\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Créer un DataFrame avec les valeurs SHAP\n",
    "shap_df = pd.DataFrame(shap_values, columns=X_test_sample.columns)\n",
