    "    \"\\n\",\n",
    "    \"print(f\\\"\\\"\\\"\\n\",\n",
    "    \"⚠️  IMPORTANT : SVR est TRÈS coûteux computationnellement\\n\",\n",
    "    \"   • Complexité : O(n² × n³) avec n = nombre d'observations\\n\",\n",
    "    \"   • Votre dataset : {X_train_scaled.shape[0]:,} observations\\n\",\n",
    "    \"\\n\",\n",
    "    \"💡 Solution : Échantillonnage stratifié pour l'entraînement\\n\",\n",
    "    \"   • Entraînement sur un échantillon représentatif\\n\",\n",
    "    \"   • Évaluation sur le dataset complet\\n\",\n",
    "    \"\\\"\\\"\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Définir la taille de l'échantillon (max 50k pour SVR)\\n\",\n",
    "    \"MAX_SAMPLES_SVR = 50000\\n\",\n",
    "    \"\\n\",\n",
    "    \"if X_train_scaled.shape[0] > MAX_SAMPLES_SVR:\\n\",\n",
    "    \"    print(f\\\"\\\\n📊 Échantillonnage nécessaire :\\\")\\n\",\n",
    "    \"    print(f\\\"   • Dataset original  : {X_train_scaled.shape[0]:,} observations\\\")\\n\",\n",
    "    \"    print(f\\\"   • Échantillon SVR   : {MAX_SAMPLES_SVR:,} observations\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Échantillonnage stratifié par quantiles de prix\\n\",\n",
    "    \"    from sklearn.model_selection import train_test_split\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Créer des bins de prix pour stratification\\n\",\n",
    "    \"    y_train_binned = pd.qcut(y_train, q=10, labels=False, duplicates='drop')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Échantillonner\\n\",\n",
    "    \"    X_train_svr, _, y_train_svr, _ = train_test_split(\\n\",\n",
    "    \"        X_train_scaled, y_train,\\n\",\n",
    "    \"        train_size=MAX_SAMPLES_SVR,\\n\",\n",
    "    \"        stratify=y_train_binned,\\n\",\n",
    "    \"        random_state=42\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"   • Échantillon créé : {X_train_svr.shape[0]:,} observations\\\")\\n\",\n",
    "    \"    print(\\\"   ✓ Stratification par quantiles de prix (distribution préservée)\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    X_train_svr = X_train_scaled\\n\",\n",
    "    \"    y_train_svr = y_train\\n\",\n",
    "    \"    print(f\\\"\\\\n✓ Dataset suffisamment petit : {X_train_scaled.shape[0]:,} observations\\\")\\n\",\n",
    "    \"    print(\\\"  → Utilisation du dataset complet\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 3. ENTRAÎNEMENT INITIAL AVEC PARAMÈTRES PAR DÉFAUT\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"3️⃣  ENTRAÎNEMENT INITIAL (Paramètres par défaut)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Entraînement du modèle SVR (RBF)...\\\")\\n\",\n",
    "    \"print(\\\"   ⚠️  Cela peut prendre plusieurs minutes...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Configuration initiale\\n\",\n",
    "    \"model_svr_default = SVR(\\n\",\n",
    "    \"    kernel='rbf',\\n\",\n",
    "    \"    C=1.0,              # Régularisation (1.0 = défaut)\\n\",\n",
    "    \"    epsilon=0.1,        # Tube epsilon (marge d'erreur tolérée)\\n\",\n",
    "    \"    gamma='scale',      # Coefficient du kernel RBF\\n\",\n",
    "    \"    cache_size=500,     # Cache pour accélérer (500 MB)\\n\",\n",
    "    \"    verbose=False\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Chronométrer l'entraînement\\n\",\n",
    "    \"start_time = time.time()\\n\",\n",
    "    \"model_svr_default.fit(X_train_svr, y_train_svr)\\n\",\n",
    "    \"training_time = time.time() - start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"   ✓ Modèle entraîné en {training_time:.2f} secondes\\\")\\n\",\n",
    "    \"print(f\\\"   • Support Vectors : {model_svr_default.n_support_.sum():,} ({model_svr_default.n_support_.sum() / len(X_train_svr) * 100:.1f}% des données)\\\")\\n\",\n",
    "    \"print(f\\\"   • Kernel          : {model_svr_default.kernel}\\\")\\n\",\n",
    "    \"print(f\\\"   • C               : {model_svr_default.C}\\\")\\n\",\n",
    "    \"print(f\\\"   • Epsilon         : {model_svr_default.epsilon}\\\")\\n\",\n",
    "    \"print(f\\\"   • Gamma           : {model_svr_default.gamma}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prédictions\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Génération des prédictions...\\\")\\n\",\n",
    "    \"y_train_pred_default = model_svr_default.predict(X_train_scaled)\\n\",\n",
    "    \"y_val_pred_default = model_svr_default.predict(X_val_scaled)\\n\",\n",
    "    \"y_test_pred_default = model_svr_default.predict(X_test_scaled)\\n\",\n",
    "    \"print(\\\"   ✓ Prédictions générées\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 4. ÉVALUATION DES PERFORMANCES (Modèle par défaut)\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"4️⃣  ÉVALUATION DES PERFORMANCES (Modèle par défaut)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate_model(y_true, y_pred, dataset_name):\\n\",\n",
    "    \"    \\\"\\\"\\\"Calcule les métriques de performance\\\"\\\"\\\"\\n\",\n",
    "    \"    mse = mean_squared_error(y_true, y_pred)\\n\",\n",
    "    \"    rmse = np.sqrt(mse)\\n\",\n",
    "    \"    mae = mean_absolute_error(y_true, y_pred)\\n\",\n",
    "    \"    r2 = r2_score(y_true, y_pred)\\n\",\n",
    "    \"    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'Dataset': dataset_name,\\n\",\n",
    "    \"        'RMSE': rmse,\\n\",\n",
    "    \"        'MAE': mae,\\n\",\n",
    "    \"        'R²': r2,\\n\",\n",
    "    \"        'MAPE (%)': mape\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calcul des métriques\\n\",\n",
    "    \"results_default = []\\n\",\n",
    "    \"results_default.append(evaluate_model(y_train, y_train_pred_default, 'Train'))\\n\",\n",
    "    \"results_default.append(evaluate_model(y_val, y_val_pred_default, 'Validation'))\\n\",\n",
    "    \"results_default.append(evaluate_model(y_test, y_test_pred_default, 'Test'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_default_df = pd.DataFrame(results_default)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Métriques SVR (paramètres par défaut) :\\\\n\\\")\\n\",\n",
    "    \"print(results_default_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Analyse du surapprentissage\\n\",\n",
    "    \"train_r2 = results_default_df.loc[0, 'R²']\\n\",\n",
    "    \"val_r2 = results_default_df.loc[1, 'R²']\\n\",\n",
    "    \"test_r2 = results_default_df.loc[2, 'R²']\\n\",\n",
    "    \"diff_r2 = train_r2 - val_r2\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n🔍 Analyse du surapprentissage :\\\")\\n\",\n",
    "    \"print(f\\\"   • Différence R² (Train - Val) : {diff_r2:.4f}\\\")\\n\",\n",
    "    \"if diff_r2 < 0.05:\\n\",\n",
    "    \"    print(\\\"   ✓ Pas de surapprentissage détecté\\\")\\n\",\n",
    "    \"elif diff_r2 < 0.10:\\n\",\n",
    "    \"    print(\\\"   ⚠️  Léger surapprentissage\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"   ❌ Surapprentissage important → Augmenter C (régularisation)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 5. OPTIMISATION DES HYPERPARAMÈTRES (Grid Search - OPTIONNEL)\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"5️⃣  OPTIMISATION DES HYPERPARAMÈTRES (Grid Search)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\"\\\"\\n\",\n",
    "    \"💡 Grid Search pour optimiser C, epsilon et gamma\\n\",\n",
    "    \"   ⚠️  TRÈS COÛTEUX : peut prendre 30+ minutes\\n\",\n",
    "    \"\\n\",\n",
    "    \"Voulez-vous exécuter le Grid Search ?\\n\",\n",
    "    \"   → OUI : Décommentez le bloc ci-dessous\\n\",\n",
    "    \"   → NON : Utiliser les paramètres par défaut (recommandé pour un premier test)\\n\",\n",
    "    \"\\\"\\\"\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==============================================================\\n\",\n",
    "    \"# 🔧 DÉCOMMENTER CE BLOC POUR ACTIVER LE GRID SEARCH\\n\",\n",
    "    \"# ==============================================================\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Lancement du Grid Search (échantillon réduit)...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Réduire encore l'échantillon pour le Grid Search\\n\",\n",
    "    \"MAX_SAMPLES_GRID = 5000\\n\",\n",
    "    \"if X_train_svr.shape[0] > MAX_SAMPLES_GRID:\\n\",\n",
    "    \"    X_grid, _, y_grid, _ = train_test_split(\\n\",\n",
    "    \"        X_train_svr, y_train_svr,\\n\",\n",
    "    \"        train_size=MAX_SAMPLES_GRID,\\n\",\n",
    "    \"        random_state=42\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    X_grid, y_grid = X_train_svr, y_train_svr\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Grille de paramètres\\n\",\n",
    "    \"param_grid = {\\n\",\n",
    "    \"    'C': [0.1, 1, 10],              # Régularisation\\n\",\n",
    "    \"    'epsilon': [0.01, 0.1, 0.5],    # Marge d'erreur\\n\",\n",
    "    \"    'gamma': ['scale', 0.001, 0.01] # Coefficient RBF\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"   • Échantillon : {len(X_grid):,} observations\\\")\\n\",\n",
    "    \"print(f\\\"   • Combinaisons à tester : {len(param_grid['C']) * len(param_grid['epsilon']) * len(param_grid['gamma'])}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"grid_search = GridSearchCV(\\n\",\n",
    "    \"    SVR(kernel='rbf', cache_size=500),\\n\",\n",
    "    \"    param_grid,\\n\",\n",
    "    \"    cv=3,\\n\",\n",
    "    \"    scoring='r2',\\n\",\n",
    "    \"    n_jobs=-1,\\n\",\n",
    "    \"    verbose=2\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"start_grid = time.time()\\n\",\n",
    "    \"grid_search.fit(X_grid, y_grid)\\n\",\n",
    "    \"grid_time = time.time() - start_grid\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n✓ Grid Search terminé en {grid_time/60:.1f} minutes\\\")\\n\",\n",
    "    \"print(f\\\"\\\\n🏆 Meilleurs paramètres trouvés :\\\")\\n\",\n",
    "    \"for param, value in grid_search.best_params_.items():\\n\",\n",
    "    \"    print(f\\\"   • {param:10s} : {value}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\n   • Meilleur R² (CV) : {grid_search.best_score_:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Réentraîner avec les meilleurs paramètres sur le full dataset\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Réentraînement avec les meilleurs paramètres...\\\")\\n\",\n",
    "    \"model_svr_optimized = grid_search.best_estimator_\\n\",\n",
    "    \"model_svr_optimized.fit(X_train_svr, y_train_svr)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prédictions optimisées\\n\",\n",
    "    \"y_train_pred_opt = model_svr_optimized.predict(X_train_scaled)\\n\",\n",
    "    \"y_val_pred_opt = model_svr_optimized.predict(X_val_scaled)\\n\",\n",
    "    \"y_test_pred_opt = model_svr_optimized.predict(X_test_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Évaluation\\n\",\n",
    "    \"results_opt = []\\n\",\n",
    "    \"results_opt.append(evaluate_model(y_train, y_train_pred_opt, 'Train'))\\n\",\n",
    "    \"results_opt.append(evaluate_model(y_val, y_val_pred_opt, 'Validation'))\\n\",\n",
    "    \"results_opt.append(evaluate_model(y_test, y_test_pred_opt, 'Test'))\\n\",\n",
    "    \"results_opt_df = pd.DataFrame(results_opt)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n📊 Métriques SVR (optimisé) :\\\\n\\\")\\n\",\n",
    "    \"print(results_opt_df.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Utiliser le modèle optimisé\\n\",\n",
    "    \"model_svr = model_svr_optimized\\n\",\n",
    "    \"y_train_pred = y_train_pred_opt\\n\",\n",
    "    \"y_val_pred = y_val_pred_opt\\n\",\n",
    "    \"y_test_pred = y_test_pred_opt\\n\",\n",
    "    \"results_df = results_opt_df\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"# ==============================================================\\n\",\n",
    "    \"# FIN DU BLOC GRID SEARCH\\n\",\n",
    "    \"# ==============================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Par défaut, utiliser le modèle avec paramètres par défaut\\n\",\n",
    "    \"model_svr = model_svr_default\\n\",\n",
    "    \"y_train_pred = y_train_pred_default\\n\",\n",
    "    \"y_val_pred = y_val_pred_default\\n\",\n",
    "    \"y_test_pred = y_test_pred_default\\n\",\n",
    "    \"results_df = results_default_df\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n✓ Utilisation du modèle avec paramètres par défaut\\\")\\n\",\n",
    "    \"print(\\\"  (Décommentez le bloc Grid Search pour optimisation)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 6. COMPARAISON AVEC MCO\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"6️⃣  COMPARAISON SVR vs MCO\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Charger les résultats MCO (supposés disponibles)\\n\",\n",
