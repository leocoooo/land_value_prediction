    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"ÉTAPE 2.5 : GESTION DES VALEURS MANQUANTES (NaN)\\n\",\n",
    "    \"================================================\\n\",\n",
    "    \"Objectif : Nettoyer les données avant la modélisation\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from sklearn.impute import SimpleImputer\\n\",\n",
    "    \"from sklearn.preprocessing import StandardScaler\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"ÉTAPE 2.5 : GESTION DES VALEURS MANQUANTES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. DIAGNOSTIC DES VALEURS MANQUANTES\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n1️⃣  DIAGNOSTIC DES VALEURS MANQUANTES\\\\n\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def diagnose_nan(df, name):\\n\",\n",
    "    \"    \\\"\\\"\\\"Diagnostique les valeurs manquantes dans un DataFrame\\\"\\\"\\\"\\n\",\n",
    "    \"    total_nan = df.isna().sum().sum()\\n\",\n",
    "    \"    print(f\\\"\\\\n📊 {name}:\\\")\\n\",\n",
    "    \"    print(f\\\"   • Shape              : {df.shape}\\\")\\n\",\n",
    "    \"    print(f\\\"   • Total NaN          : {total_nan:,}\\\")\\n\",\n",
    "    \"    print(f\\\"   • % de NaN           : {(total_nan / df.size * 100):.2f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if total_nan > 0:\\n\",\n",
    "    \"        nan_cols = df.columns[df.isna().any()].tolist()\\n\",\n",
    "    \"        print(f\\\"   • Colonnes avec NaN  : {len(nan_cols)}\\\")\\n\",\n",
    "    \"        print(f\\\"\\\\n   📋 Détail par colonne (Top 10):\\\")\\n\",\n",
    "    \"        nan_counts = df.isna().sum().sort_values(ascending=False).head(10)\\n\",\n",
    "    \"        for col, count in nan_counts.items():\\n\",\n",
    "    \"            if count > 0:\\n\",\n",
    "    \"                pct = (count / len(df)) * 100\\n\",\n",
    "    \"                print(f\\\"      - {col:40s} : {count:>8,} ({pct:>5.2f}%)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return total_nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Diagnostic des ensembles\\n\",\n",
    "    \"print(\\\"🔍 AVANT TRAITEMENT :\\\")\\n\",\n",
    "    \"nan_train = diagnose_nan(X_train_final, \\\"X_train_final\\\")\\n\",\n",
    "    \"nan_val = diagnose_nan(X_val_final, \\\"X_val_final\\\")\\n\",\n",
    "    \"nan_test = diagnose_nan(X_test_final, \\\"X_test_final\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 2. IMPUTATION DES VALEURS MANQUANTES\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"2️⃣  IMPUTATION DES VALEURS MANQUANTES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n💡 Stratégie d'imputation :\\\")\\n\",\n",
    "    \"print(\\\"   • Méthode : Médiane (robuste aux outliers)\\\")\\n\",\n",
    "    \"print(\\\"   • Fit sur : Train uniquement (éviter le data leakage)\\\")\\n\",\n",
    "    \"print(\\\"   • Transform : Train, Validation, Test\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer l'imputer\\n\",\n",
    "    \"imputer = SimpleImputer(strategy='median', add_indicator=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Application de l'imputation...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Fit sur train et transform tous les ensembles\\n\",\n",
    "    \"X_train_imputed = pd.DataFrame(\\n\",\n",
    "    \"    imputer.fit_transform(X_train_final),\\n\",\n",
    "    \"    columns=X_train_final.columns,\\n\",\n",
    "    \"    index=X_train_final.index\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_val_imputed = pd.DataFrame(\\n\",\n",
    "    \"    imputer.transform(X_val_final),\\n\",\n",
    "    \"    columns=X_val_final.columns,\\n\",\n",
    "    \"    index=X_val_final.index\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_test_imputed = pd.DataFrame(\\n\",\n",
    "    \"    imputer.transform(X_test_final),\\n\",\n",
    "    \"    columns=X_test_final.columns,\\n\",\n",
    "    \"    index=X_test_final.index\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"   ✓ Imputation terminée\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Vérification\\n\",\n",
    "    \"print(\\\"\\\\n✅ APRÈS IMPUTATION :\\\")\\n\",\n",
    "    \"nan_train_after = diagnose_nan(X_train_imputed, \\\"X_train_imputed\\\")\\n\",\n",
    "    \"nan_val_after = diagnose_nan(X_val_imputed, \\\"X_val_imputed\\\")\\n\",\n",
    "    \"nan_test_after = diagnose_nan(X_test_imputed, \\\"X_test_imputed\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 3. STANDARDISATION DES DONNÉES\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"3️⃣  STANDARDISATION DES DONNÉES\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n💡 Objectif : Normaliser pour le modèle MCO\\\")\\n\",\n",
    "    \"print(\\\"   • Transformation : (X - μ) / σ\\\")\\n\",\n",
    "    \"print(\\\"   • Moyenne = 0, Écart-type = 1\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Identifier les colonnes binaires (ne pas standardiser)\\n\",\n",
    "    \"binary_cols = [\\n\",\n",
    "    \"    col for col in X_train_imputed.columns\\n\",\n",
    "    \"    if X_train_imputed[col].nunique() <= 2\\n\",\n",
    "    \"]\\n\",\n",
    "    \"cols_to_scale = [\\n\",\n",
    "    \"    col for col in X_train_imputed.columns\\n\",\n",
    "    \"    if col not in binary_cols\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n📊 Analyse des colonnes :\\\")\\n\",\n",
    "    \"print(f\\\"   • Colonnes binaires (non standardisées) : {len(binary_cols)}\\\")\\n\",\n",
    "    \"print(f\\\"   • Colonnes à standardiser               : {len(cols_to_scale)}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer le scaler\\n\",\n",
    "    \"scaler = StandardScaler()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n⏳ Application de la standardisation...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Fit sur train uniquement\\n\",\n",
    "    \"scaler.fit(X_train_imputed[cols_to_scale])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Créer copies\\n\",\n",
    "    \"X_train_scaled = X_train_imputed.copy()\\n\",\n",
    "    \"X_val_scaled = X_val_imputed.copy()\\n\",\n",
    "    \"X_test_scaled = X_test_imputed.copy()\\n\",\n",
