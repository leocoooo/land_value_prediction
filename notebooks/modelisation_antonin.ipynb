    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"6️⃣  GÉNÉRATION DES VISUALISATIONS\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig = plt.figure(figsize=(18, 12))\\n\",\n",
    "    \"gs = fig.add_gridspec(3, 3, hspace=0.35, wspace=0.3)\\n\",\n",
    "    \"\\n\",\n",
