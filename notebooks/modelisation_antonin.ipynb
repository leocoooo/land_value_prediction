    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. CHOIX DU KERNEL ET CONFIGURATION\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n1️⃣  CONFIGURATION DU MODÈLE SVR\\\\n\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\"\\\"\\n\",\n",
    "    \"💡 Choix du kernel pour SVR :\\n\",\n",
    "    \"\\n\",\n",
    "    \"   🔹 LINEAR    : Relations linéaires (similaire à MCO mais avec régularisation)\\n\",\n",
    "    \"   🔹 POLY      : Relations polynomiales (degré 2, 3...)\\n\",\n",
    "    \"   🔹 RBF       : Relations non-linéaires complexes (Radial Basis Function)\\n\",\n",
    "    \"   🔹 SIGMOID   : Relations en forme de S\\n\",\n",
    "    \"\\n\",\n",
    "    \"Pour les prix immobiliers :\\n\",\n",
    "    \"   → RBF (Gaussian) est le PLUS ADAPTÉ\\n\",\n",
