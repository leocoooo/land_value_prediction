    "    \"print(\\\"  → ÉTAPE 4 : Modèles avancés (Random Forest, XGBoost)\\\")\\n\",\n",
    "    \"print(\\\"  → ÉTAPE 5 : Deep Learning (PyTorch)\\\")\\n\",\n",
    "    \"print(\\\"  → ÉTAPE 6 : Interprétabilité (SHAP)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Visualisation rapide\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Distribution de la cible\\n\",\n",
    "    \"axes[0].hist(y_train, bins=50, alpha=0.7, label='Train', edgecolor='black')\\n\",\n",
