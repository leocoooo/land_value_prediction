    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import requests\\n\",\n",
    "    \"import time\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"\\n\",\n",
    "    \"def geocoder_adresse(numero, nom_voie, code_postal, commune):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Géocode une adresse via l'API Géoplateforme\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Construire l'adresse complète\\n\",\n",
    "    \"    adresse_parts = []\\n\",\n",
    "    \"    if pd.notna(numero) and str(numero).strip():\\n\",\n",
    "    \"        adresse_parts.append(str(numero))\\n\",\n",
    "    \"    if pd.notna(nom_voie) and str(nom_voie).strip():\\n\",\n",
    "    \"        adresse_parts.append(str(nom_voie))\\n\",\n",
    "    \"    if pd.notna(code_postal) and str(code_postal).strip():\\n\",\n",
    "    \"        adresse_parts.append(str(code_postal))\\n\",\n",
    "    \"    if pd.notna(commune) and str(commune).strip():\\n\",\n",
    "    \"        adresse_parts.append(str(commune))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    adresse = \\\" \\\".join(adresse_parts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not adresse.strip():\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Appeler l'API\\n\",\n",
    "    \"    url = \\\"https://data.geopf.fr/geocodage/search\\\"\\n\",\n",
    "    \"    params = {\\n\",\n",
    "    \"        \\\"q\\\": adresse,\\n\",\n",
    "    \"        \\\"limit\\\": 1\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        response = requests.get(url, params=params, timeout=10)\\n\",\n",
    "    \"        response.raise_for_status()\\n\",\n",
    "    \"        data = response.json()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if data.get(\\\"features\\\") and len(data[\\\"features\\\"]) > 0:\\n\",\n",
    "    \"            coords = data[\\\"features\\\"][0][\\\"geometry\\\"][\\\"coordinates\\\"]\\n\",\n",
    "    \"            return coords[0], coords[1]  # longitude, latitude\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            return None, None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        print(f\\\"Erreur pour '{adresse}': {e}\\\")\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def geocoder_dataframe(df, batch_size=100, delay=0.05):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Géocode toutes les lignes d'un DataFrame par batch\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        df: DataFrame avec les colonnes adresse_numero, adresse_nom_voie, code_postal, nom_commune\\n\",\n",
    "    \"        batch_size: Nombre de lignes à traiter avant de sauvegarder\\n\",\n",
    "    \"        delay: Délai entre chaque requête en secondes (pour respecter la limite de 50 req/s)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    total_rows = len(df)\\n\",\n",
    "    \"    print(f\\\"Géocodage de {total_rows} adresses...\\\")\\n\",\n",
    "    \"    print(f\\\"Traitement par batch de {batch_size} lignes\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Initialiser les colonnes si elles n'existent pas\\n\",\n",
    "    \"    if 'longitude' not in df.columns:\\n\",\n",
    "    \"        df['longitude'] = None\\n\",\n",
    "    \"    if 'latitude' not in df.columns:\\n\",\n",
    "    \"        df['latitude'] = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Créer un fichier de sauvegarde\\n\",\n",
    "    \"    backup_file = \\\"geocodage_backup.csv\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Compter les lignes déjà géocodées\\n\",\n",
    "    \"    lignes_a_geocoder = df[df['longitude'].isna()].index\\n\",\n",
    "    \"    print(f\\\"{len(lignes_a_geocoder)} adresses à géocoder\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Barre de progression\\n\",\n",
    "    \"    with tqdm(total=len(lignes_a_geocoder), desc=\\\"Géocodage\\\") as pbar:\\n\",\n",
    "    \"        batch_count = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for idx in lignes_a_geocoder:\\n\",\n",
    "    \"            row = df.loc[idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Géocoder l'adresse\\n\",\n",
    "    \"            lon, lat = geocoder_adresse(\\n\",\n",
    "    \"                row['adresse_numero'],\\n\",\n",
    "    \"                row['adresse_nom_voie'],\\n\",\n",
    "    \"                row['code_postal'],\\n\",\n",
    "    \"                row['nom_commune']\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Mettre à jour le DataFrame\\n\",\n",
    "    \"            df.at[idx, 'longitude'] = lon\\n\",\n",
    "    \"            df.at[idx, 'latitude'] = lat\\n\",\n",
    "    \"\\n\",\n",
    "    \"            batch_count += 1\\n\",\n",
    "    \"            pbar.update(1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Sauvegarder périodiquement\\n\",\n",
    "    \"            if batch_count % batch_size == 0:\\n\",\n",
    "    \"                df.to_csv(backup_file, index=False)\\n\",\n",
    "    \"                print(f\\\"\\\\n✓ Backup sauvegardé ({batch_count} lignes traitées)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Respecter la limite de 50 requêtes par seconde\\n\",\n",
    "    \"            time.sleep(delay)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Sauvegarde finale\\n\",\n",
    "    \"    df.to_csv(backup_file, index=False)\\n\",\n",
    "    \"    print(f\\\"\\\\n✓ Géocodage terminé!\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Statistiques\\n\",\n",
    "    \"    geocoded = df['longitude'].notna().sum()\\n\",\n",
    "    \"    print(f\\\"\\\\nRésultats:\\\")\\n\",\n",
    "    \"    print(f\\\"  - Adresses géocodées: {geocoded} / {total_rows} ({geocoded/total_rows*100:.1f}%)\\\")\\n\",\n",
    "    \"    print(f\\\"  - Adresses non trouvées: {total_rows - geocoded}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return df\"\n",
